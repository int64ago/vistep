---
interface Props {
  slug: string;
  color: string;
}
import { engineCycle } from '../models/four-stroke';
import { planetaryOutlines, planetaryState } from '../models/planetary';
import type { Point2 } from '../models/mechanisms';
import { traceFiber } from '../models/fiber';
import { fullAdder } from '../models/adder';
import { phaseDiskPath } from '../models/moon';
const { slug, color } = Astro.props;
const grid = Array.from({ length: 8 }, (_, i) => i);
const engine = engineCycle(2.4 * Math.PI);
const enginePin = 184 - engine.pinY * 650;
const engineCrankX = 200 + engine.crankX * 650;
const engineCrankY = 184 - engine.crankY * 650;
const planetary =
  slug === 'planetary-gears'
    ? { outlines: planetaryOutlines(), state: planetaryState(0.43, 'ring-fixed') }
    : null;
const gearPath = (points: Point2[]) =>
  points.map((v, i) => `${i ? 'L' : 'M'}${v.x} ${v.y}`).join(' ') + 'Z';
const fiber = slug === 'optical-fiber' ? traceFiber(12, 1.46, 600) : null;
const adder = slug === 'binary-adder' ? fullAdder(1, 1) : null;
---

<svg viewBox="0 0 400 230" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs
    ><pattern id={`dots-${slug}`} width="18" height="18" patternUnits="userSpaceOnUse"
      ><circle cx="1" cy="1" r=".65" fill="#7b90b1" opacity=".2"></circle></pattern
    ><linearGradient id={`fade-${slug}`} x1="0" x2="1" y2="1"
      ><stop stop-color={color} stop-opacity=".14"></stop><stop
        offset="1"
        stop-color={color}
        stop-opacity="0"></stop></linearGradient
    ></defs
  >
  <rect width="400" height="230" fill={`url(#fade-${slug})`}></rect><rect
    width="400"
    height="230"
    fill={`url(#dots-${slug})`}></rect>
  {
    slug === 'moon-phases' && (
      <g>
        <defs>
          <radialGradient id="lunar-cover-bg">
            <>
              <stop stop-color="#2f3b52" />
              <stop offset="1" stop-color="#101c30" />
            </>
          </radialGradient>
          <clipPath id="lunar-cover-light">
            <path d={phaseDiskPath(0.52, 84)} transform="translate(246 112)" />
          </clipPath>
        </defs>
        <rect width="400" height="230" fill="url(#lunar-cover-bg)" />
        <circle cx="246" cy="112" r="84" fill="#101a2b" stroke="#71839c" stroke-width=".5" />
        <path d={phaseDiskPath(0.52, 84)} transform="translate(246 112)" fill="#d3d3c7" />
        <g clip-path="url(#lunar-cover-light)" fill="#84969a" fill-opacity=".32">
          <>
            <ellipse cx="238" cy="80" rx="27" ry="22" />
            <ellipse cx="277" cy="87" rx="22" ry="27" />
          </>
          <>
            <ellipse cx="230" cy="122" rx="22" ry="14" />
            <circle cx="282" cy="56" r="8" />
          </>
          {Array.from({ length: 32 }, (_, i) => {
            const a = i * 2.39996,
              r = Math.sqrt((i + 0.5) / 32) * 76;
            return (
              <circle
                cx={246 + r * Math.cos(a)}
                cy={112 + r * Math.sin(a)}
                r={2 + (i % 4)}
                fill="none"
                stroke="#647d85"
                stroke-width=".9"
              />
            );
          })}
        </g>
        <path
          d="M47 59H116M47 77H116M47 95H116"
          stroke="#d2b782"
          stroke-width="1"
          stroke-opacity=".6"
        />
        <text
          x="28"
          y="200"
          font-family="Manrope"
          font-size="11"
          letter-spacing="1.4"
          fill="#a9b7c9"
        >
          A CHANGE OF VIEW
        </text>
      </g>
    )
  }
  {
    slug === 'hydraulic-brake' && (
      <g>
        <rect width="400" height="230" fill="#e9e9df" />
        <path
          d="M69 82C89 26 148 39 163 51S246 49 268 70V83"
          fill="none"
          stroke="#424e4c"
          stroke-width="7"
          stroke-linecap="round"
        />
        <circle cx="264" cy="134" r="71" fill="#b7c0bb" stroke="#7c8d85" stroke-width="1.4" />
        <circle cx="264" cy="134" r="58" fill="none" stroke="#98a79d" stroke-width="1" />
        {Array.from({ length: 16 }, (_, i) => {
          const a = (i * Math.PI) / 8;
          return (
            <circle cx={264 + 62 * Math.cos(a)} cy={134 + 62 * Math.sin(a)} r="3" fill="#e9e9df" />
          );
        })}
        <circle cx="264" cy="134" r="24" fill="#52615b" />
        <circle cx="264" cy="134" r="10" fill="#e9e9df" />
        <rect x="241" y="65" width="47" height="48" rx="12" fill="#a17158" />
        <rect x="246" y="80" width="37" height="19" rx="4" fill="#d7b878" />
        <rect x="42" y="72" width="80" height="25" rx="10" fill="#8b9b91" />
        <rect x="52" y="51" width="39" height="25" rx="4" fill="#bac4b5" />
        <path
          d="M39 84C22 108 26 144 45 161"
          fill="none"
          stroke="#414f49"
          stroke-width="9"
          stroke-linecap="round"
        />
        <path d="M74 77H109M256 88H278" stroke="#d6b469" stroke-width="6" />
        <text
          x="30"
          y="207"
          fill="#7c8979"
          font-family="Manrope"
          font-size="11"
          letter-spacing="1.4"
        >
          PRESSURE / GRIP
        </text>
      </g>
    )
  }
  {
    adder && (
      <g>
        <rect width="400" height="230" fill="#e9eddf" />
        <path
          d="M70 79C130 79 132 77 173 77M70 147C122 147 117 99 173 99M70 79C96 79 105 151 173 151M70 147C132 147 132 173 173 173"
          fill="none"
          stroke="#ac8767"
          stroke-width="2"
        />
        <path
          d="M177 65Q212 65 238 88Q212 111 177 111Q195 88 177 65ZM170 65Q188 88 170 111"
          fill="#f4f3e9"
          stroke="#839677"
          stroke-width="1.6"
        />
        <path
          d="M173 140H209A22 22 0 0 1 209 184H173Z"
          fill="#f4f3e9"
          stroke="#a47f5f"
          stroke-width="1.6"
        />
        <path d="M238 88H309M231 162H309" stroke="#8da386" stroke-width="2" />
        {[79, 147].map((y) => (
          <g>
            <circle cx="70" cy={y} r="16" fill="#edf0e3" stroke="#a7b499" />
            <text
              x="70"
              y={y + 6}
              text-anchor="middle"
              font-size="20"
              font-family="Manrope"
              fill="#af7651"
            >
              1
            </text>
          </g>
        ))}
        <text x="323" y="95" font-size="23" font-family="Manrope" fill="#6e8a67">
          {adder.p.value}
        </text>
        <text x="323" y="169" font-size="23" font-family="Manrope" fill="#ad7853">
          {adder.g.value}
        </text>
        <text
          x="30"
          y="32"
          fill="#839675"
          font-family="Manrope"
          font-size="11"
          letter-spacing="1.5"
        >
          ONE + ONE
        </text>
        <text x="370" y="210" text-anchor="end" fill="#879379" font-family="Manrope" font-size="11">
          SUM / CARRY
        </text>
      </g>
    )
  }
  {
    fiber && (
      <g>
        <rect width="400" height="230" fill="#222d48" />
        <rect x="32" y="53" width="336" height="124" fill="#56617d" fill-opacity=".23" />
        <rect
          x="32"
          y="78"
          width="336"
          height="74"
          fill="#708ca7"
          fill-opacity=".25"
          stroke="#8da8c3"
          stroke-opacity=".35"
        />
        <rect
          x="32"
          y="101"
          width="336"
          height="28"
          fill="#a6d1dc"
          fill-opacity=".2"
          stroke="#b2d6df"
          stroke-opacity=".65"
        />
        {fiber.segments
          .filter((s) => !s.escaped)
          .map((s) => (
            <path
              d={`M${32 + s.a.x * 0.56} ${115 - s.a.y * 0.56}L${32 + s.b.x * 0.56} ${115 - s.b.y * 0.56}`}
              stroke="#efca92"
              stroke-width="2"
            />
          ))}
        {fiber.hits.map((p) => (
          <circle cx={32 + p.x * 0.56} cy={115 - p.y * 0.56} r="3" fill="#f8dea9" />
        ))}
        <text
          x="32"
          y="32"
          fill="#94aec9"
          font-family="Manrope"
          font-size="11"
          letter-spacing="1.5"
        >
          LIGHT, GUIDED.
        </text>
        <text x="368" y="205" text-anchor="end" fill="#92a7c4" font-family="Manrope" font-size="11">
          1.480 / 1.460
        </text>
      </g>
    )
  }
  {
    planetary && (
      <g>
        <rect width="400" height="230" fill="#203744" />
        <g transform="translate(200 116) scale(58 -58)">
          <circle r="1.68" stroke="#4f6a76" stroke-width=".05" />
          {planetary.state.planets.map((p) => (
            <path
              d={`M${p.x * 0.2} ${p.y * 0.2}L${p.x} ${p.y}`}
              stroke="#548e85"
              stroke-width=".14"
              stroke-linecap="round"
            />
          ))}
          <path
            d={`M1.55 0A1.55 1.55 0 1 0 -1.55 0A1.55 1.55 0 1 0 1.55 0Z${gearPath(planetary.outlines.ring)}`}
            fill="#8ba3b1"
            fill-rule="evenodd"
          />
          <path
            d={gearPath(planetary.outlines.sun)}
            transform={`rotate(${(planetary.state.sun * 180) / Math.PI})`}
            fill="#c6aa77"
          />
          {planetary.state.planets.map((p, i) => (
            <g transform={`translate(${p.x} ${p.y}) rotate(${(p.angle * 180) / Math.PI})`}>
              <path
                d={gearPath(planetary.outlines.planet)}
                fill={i === 0 ? '#7db7aa' : '#b1c5c6'}
              />
              <circle r=".095" fill="#203744" />
              <circle cx=".25" r=".036" fill="#f2d69d" />
            </g>
          ))}
          <circle r=".12" fill="#203744" />
        </g>
        <text
          x="24"
          y="30"
          fill="#9fbbb9"
          font-family="Manrope"
          font-size="11"
          letter-spacing="1.4"
        >
          24 / 18 / 60
        </text>
        <text
          x="376"
          y="213"
          text-anchor="end"
          fill="#97afa9"
          font-family="Manrope"
          font-size="10"
          letter-spacing="1.1"
        >
          SPIN + ORBIT
        </text>
      </g>
    )
  }
  {
    slug === 'four-stroke-engine' && (
      <g>
        <path
          d="M170 44V151M230 44V151M170 44H230"
          stroke="#789487"
          stroke-width="8"
          stroke-linejoin="round"
        />
        <rect
          x="174"
          y="44"
          width="52"
          height={Math.max(1, enginePin - 17 - 44)}
          fill="#bc9160"
          fill-opacity=".3"
        />
        <path
          d="M112 32H186V44M288 32H214V44"
          stroke="#8d9e8e"
          stroke-width="9"
          stroke-linejoin="round"
        />
        <path d="M186 18V44m-7 0h14M214 18V44m-7 0h14" stroke="#bac3a9" stroke-width="4" />
        <rect
          x="175"
          y={enginePin - 17}
          width="50"
          height="29"
          rx="4"
          fill="#afbca7"
          stroke="#8da28e"
          stroke-width="2"
        />
        <path
          d={`M176 ${enginePin - 10}H224M176 ${enginePin - 5}H224`}
          stroke="#829a85"
          stroke-width="2"
        />
        <circle
          cx="200"
          cy="184"
          r="34"
          fill="#a4b49d"
          fill-opacity=".2"
          stroke="#9caa91"
          stroke-width="6"
        />
        <path
          d={`M200 184L${engineCrankX} ${engineCrankY}`}
          stroke="#738b78"
          stroke-width="16"
          stroke-linecap="round"
        />
        <path
          d={`M200 ${enginePin}L${engineCrankX} ${engineCrankY}`}
          stroke="#b29968"
          stroke-width="12"
          stroke-linecap="round"
        />
        {[
          [200, enginePin],
          [engineCrankX, engineCrankY],
          [200, 184],
        ].map(([cx, cy]) => (
          <circle cx={cx} cy={cy} r="5" fill="#e2e5cf" stroke="#6f8775" stroke-width="2" />
        ))}
        <path d="M200 20V44" stroke="#b8a272" stroke-width="5" stroke-linecap="round" />
        <circle cx="200" cy="50" r="4" fill="#cf9e61" />
      </g>
    )
  }
  {
    slug === 'camera-lens' && (
      <g>
        <path d="M42 174H360" stroke="#9aa890" stroke-width="8" stroke-linecap="round" />
        <path d="M76 169V94m-8 12 8-12 8 12" stroke="#bb975b" stroke-width="4" />
        <path
          d="M204 54Q178 106 204 158Q230 106 204 54Z"
          fill="#c5d9d0"
          fill-opacity=".5"
          stroke="#84a895"
          stroke-width="2"
        />
        <path d="M302 62V159" stroke="#3f5b4a" stroke-width="5" />
        <path
          d="M76 94L204 80L302 116M76 94L204 106L302 116M76 94L204 132L302 116"
          stroke="#c0a063"
          stroke-width="1.8"
          fill="none"
        />
        <>
          <circle cx="76" cy="94" r="4" fill="#d2ab66" />
          <circle cx="302" cy="116" r="5" fill="#a5ba89" />
        </>
        <path d="M204 158V170M302 158V170" stroke="#819479" stroke-width="4" />
        <text
          x="204"
          y="202"
          text-anchor="middle"
          fill="#6f836a"
          font-size="12"
          font-family="Manrope"
        >
          LIGHT → IMAGE
        </text>
      </g>
    )
  }
  {
    slug === 'aperture' && (
      <g>
        <defs>
          <linearGradient id="aperture-cover" x1="0" y1="0" x2="1" y2="1">
            <>
              <stop stop-color="#25473a" />
              <stop offset="1" stop-color="#607b59" />
            </>
          </linearGradient>
        </defs>
        <rect x="42" y="34" width="316" height="165" rx="18" fill="url(#aperture-cover)" />
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <circle
            cx={70 + i * 50}
            cy={65 + Math.sin(i) * 12}
            r={8 + (i % 3) * 3}
            fill="#d1c08c"
            opacity=".4"
          />
        ))}
        <path d="M185 198Q199 157 188 110" stroke="#9da977" stroke-width="4" />
        {Array.from({ length: 12 }, (_, i) => (
          <ellipse
            cx={188 + Math.cos((i * Math.PI) / 6) * 19}
            cy={108 + Math.sin((i * Math.PI) / 6) * 19}
            rx="20"
            ry="7"
            transform={`rotate(${i * 30} ${188 + Math.cos((i * Math.PI) / 6) * 19} ${108 + Math.sin((i * Math.PI) / 6) * 19})`}
            fill="#e3ddbe"
          />
        ))}
        <circle cx="188" cy="108" r="17" fill="#b59952" />
        <>
          <circle cx="309" cy="151" r="29" fill="#1a3428" stroke="#b4bd9a" stroke-width="2" />
          <circle cx="309" cy="151" r="13" fill="#ddd6ab" />
        </>
        <text x="61" y="179" fill="#e4e8cf" font-family="Manrope" font-size="14">
          ƒ / 2.0
        </text>
      </g>
    )
  }
  {
    slug === 'bicycle' && (
      <g>
        <path d="m230 160 20 17h13" stroke="#3f5572" stroke-width="4" />
        {Array.from({ length: 8 }, (_, i) => (
          <path
            d={`M271 160l${Math.cos((i * Math.PI) / 4) * 48} ${Math.sin((i * Math.PI) / 4) * 48}`}
            stroke="#8da0b8"
            opacity=".3"
          />
        ))}
        <path d="M310 67h39m-8-6 8 6-8 6" stroke={color} stroke-width="2" />
        <text x="291" y="50" fill="#708198" font-size="9" font-family="monospace">
          FORCE → MOTION
        </text>
      </g>
    )
  }
  {
    slug === 'refrigerator' && (
      <g>
        <>
          <rect
            x="72"
            y="48"
            width="100"
            height="152"
            rx="12"
            fill="white"
            stroke="#869ab1"
            stroke-width="2"
          />
          <path d="M73 108h97m-77-42v24m0 35v40" stroke="#9cb1c7" stroke-width="3" />
          <rect x="185" y="153" width="47" height="34" rx="12" fill="#344d68" />
          <path
            d="M208 153V62h86v45h-67v26h67v35h-61M186 169h-23v-24H125V77h61"
            stroke="#bcc9d7"
            stroke-width="7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path d="M208 151V62h85v45" stroke="#e88567" stroke-width="4" stroke-linecap="round" />
          <path
            d="M294 136v32h-61M186 169h-23v-24H125V77h61"
            stroke="#4caac8"
            stroke-width="4"
            stroke-linecap="round"
          />
          <circle cx="125" cy="119" r="5" fill="#4caac8" />
          <path
            d="m105 87-8 6 8 6m0 39-8 6 8 6M315 73l8 6-8 6m0 54 8 6-8 6"
            stroke="#acb8c8"
            stroke-width="2"
          />
          <text x="278" y="48" fill="#d4795c" font-size="10" font-family="monospace">
            HEAT OUT
          </text>
        </>
      </g>
    )
  }
  {
    slug === 'printer' && (
      <g>
        <>
          <path
            d="M72 166v-54l38-53h176l31 53v54H72Z"
            fill="#dfe4ef"
            stroke="#8898af"
            stroke-width="1.5"
          />
          <path d="M144 52h99v69h-99z" fill="white" stroke="#b1bed0" />
          <path d="M155 68h76m-76 10h55m-55 10h69" stroke="#c1cddd" stroke-width="3" />
          <circle cx="192" cy="146" r="30" fill="#745bc7" stroke="#4b3d92" stroke-width="2" />
          <circle cx="192" cy="146" r="9" fill="#e1d8fa" />
          <path d="m116 87 79 27" stroke="#e47970" stroke-width="2" />
          <path d="m194 115-5 6" stroke="#f2c65b" stroke-width="4" />
          <rect x="253" y="135" width="16" height="45" rx="8" fill="#dda66a" />
          <rect x="272" y="135" width="16" height="45" rx="8" fill="#dc8a69" />
          <path d="M82 172h108l17 20h116" stroke="white" stroke-width="6" />
          <path d="M208 191h90" stroke={color} stroke-width="2" />
          <circle cx="192" cy="177" r="4" fill="#e67275" />
          <text x="251" y="119" fill="#8c799b" font-size="9" font-family="monospace">
            LIGHT → INK
          </text>
        </>
      </g>
    )
  }
  {
    slug === 'noise' && (
      <g>
        {[0, 1, 2].map((row) => (
          <g>
            <path d={`M35 ${80 + row * 45}H368`} stroke="#a1b4bf" opacity=".2" />
            <path
              d={Array.from(
                { length: 101 },
                (_, i) =>
                  `${i ? 'L' : 'M'}${38 + i * 3.25} ${80 + row * 45 + Math.sin(i / 7) * (row === 2 ? 2 : 20) * (row === 1 ? -1 : 1)}`,
              ).join(' ')}
              stroke={row === 0 ? '#4192ab' : row === 1 ? '#dd926d' : color}
              stroke-width="2.5"
            />
          </g>
        ))}
        <text x="49" y="46" fill="#627c86" font-size="10" font-family="monospace">
          NOISE + ANTI-NOISE
        </text>
        <>
          <text x="314" y="201" fill={color} font-size="11" font-family="monospace">
            ≈ SILENCE
          </text>
          <path d="M188 101v6m-3-3h6M188 144h6m-6 5h6" stroke="#78929e" stroke-width="1.5" />
        </>
      </g>
    )
  }
  {
    slug === 'gps' && (
      <g>
        <ellipse
          cx="201"
          cy="134"
          rx="112"
          ry="77"
          transform="rotate(40 201 134)"
          stroke="#93b3d4"
          stroke-dasharray="4 5"
        />
        {[
          [116, 69],
          [305, 102],
          [181, 45],
        ].map(([x, y]) => (
          <g>
            <path d={`M${x} ${y} 211 153`} stroke={color} stroke-dasharray="3 4" opacity=".55" />
            <rect x={x - 5} y={y - 6} width="10" height="12" rx="2" fill="#5d7baf" />
            <path d={`M${x - 18} ${y}h10m16 0h10`} stroke="#739aca" stroke-width="7" />
          </g>
        ))}
        <circle cx="211" cy="153" r="12" fill="#447cf230" />
        <circle cx="211" cy="153" r="5" fill={color} />
      </g>
    )
  }
  {
    slug === 'network' && (
      <g>
        {[
          [46, 108, 'YOU'],
          [151, 76, 'DNS'],
          [261, 76, 'SERVER'],
          [296, 158, 'PAGE'],
        ].map(([x, y, label]) => (
          <g>
            <rect
              x={Number(x) - 23}
              y={Number(y) - 18}
              width="58"
              height="46"
              rx="7"
              fill="#fff"
              stroke="#91a8c8"
            />
            <text
              x={Number(x) + 6}
              y={Number(y) + 8}
              text-anchor="middle"
              font-family="monospace"
              font-size="9"
              fill="#6682a8"
            >
              {label}
            </text>
          </g>
        ))}
        <path
          d="M82 116h33V99h12m59-1h51m54 11v24h12M82 133v50h190"
          stroke="#8caed8"
          stroke-width="2"
          stroke-dasharray="4 4"
        />
        <>
          <rect x="103" y="108" width="10" height="7" rx="2" fill={color} />
          <rect x="210" y="94" width="10" height="7" rx="2" fill={color} />
          <rect x="187" y="179" width="10" height="7" rx="2" fill="#50a59d" />
          <text x="174" y="52" fill="#7187a3" font-size="10" font-family="monospace">
            A REQUEST'S JOURNEY
          </text>
        </>
      </g>
    )
  }
  {
    slug === 'jpeg' && (
