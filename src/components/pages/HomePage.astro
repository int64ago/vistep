---
import Base from '../../layouts/Base.astro';
import BrandMorph from '../../components/BrandMorph';
import HomeObject from '../../components/HomeObject';
import TopicCover from '../../components/TopicCover.astro';
import DiscoveryCatalog from '../DiscoveryCatalog.astro';
import { translate, localPath, type Locale } from '../../i18n';
const { locale = 'zh' } = Astro.props as { locale?: Locale };
const tr = (s: string) => translate(s, locale);
const href = (p: string) => localPath(p, locale);
---

<Base locale={locale}>
  <main id="main" class="home-page">
    <section class="opening">
      <div class="opening-copy">
        <p class="edition-label">
          <span class="tiny-cross" aria-hidden="true">+</span>
          {tr('给好奇心，一个看得见的答案。')}
        </p>
        <BrandMorph locale={locale} client:load />
        <p class="opening-description">
          {tr('一束光怎样变成字？一个齿轮怎样改变力？')}<br class="desktop-br" />{
            tr('拆开熟悉的事物，看见那些正在发生的过程。')
          }
        </p>
        <a href={href('/explore/printer/')} class="editorial-cta"
          >{tr('从一台打印机开始')} <span aria-hidden="true">↗</span></a
        >
      </div>
      <HomeObject client:only="react"
        ><div slot="fallback" class="opening-object home-object-placeholder" aria-hidden="true">
          <TopicCover slug="printer" color="#8da486" />
        </div></HomeObject
      >
    </section>
    <noscript
      ><style is:inline>
        .brand-motion {
          display: none;
        }
        .brand-skip {
          display: none;
        }
        body:has(.brand-opening) .site-header .wordmark-name {
          opacity: 1;
        }
        .opening-title {
          opacity: 1;
          transform: none;
        }
        .brand-opening .brand-meaning {
          visibility: visible;
        }
      </style></noscript
    >
    <DiscoveryCatalog locale={locale} />
    <section class="closing-note">
      <span class="tiny-cross" aria-hidden="true">+</span><p>
        {tr('理解世界，从看清一步开始。')}
      </p><span>VISUALIZE EVERY STEP</span>
    </section>
  </main>
</Base>
