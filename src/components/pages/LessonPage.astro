---
import Base from '../../layouts/Base.astro';
import { islandDictionary } from '../../i18n/server/island-dictionary';
import Experiment from '../../components/Experiment';
import EnglishExperiment from '../../components/english/Experiment';
import { getTopic } from '../../data/topics';
import '../../styles/experiments.css';
import narration from '../../data/narration.json';
import tracks from '../../data/audio-tracks.json';
import { films, filmDuration, filmRunningTime } from '../../data/films';
import { filmWindow } from '../../lib/film';
import { nextLearningStep } from '../../data/learning-paths';
import { discoveryCategories, discoveryMetadata } from '../../data/discovery-metadata';
import { translate, localPath, localizedTopic, type Locale } from '../../i18n';
import TeachingLessonContext from '../teaching/TeachingLessonContext.astro';
import {
  curriculumPath,
  curriculumSectionPath,
  curriculumSectionNumber,
  curriculumFilmSelection,
  type CurriculumContext,
} from '../../data/curricula';
const { topic: originalTopic, Content, curriculumContext } = Astro.props;
const locale = (Astro.props.locale ?? 'zh') as Locale;
const context = curriculumContext as CurriculumContext | undefined;
const selection = curriculumFilmSelection(context?.lesson);
const selectedWindow = filmWindow(films[originalTopic.slug], selection);
const topic = localizedTopic(originalTopic, locale);
const tr = (s: string) => translate(s, locale);
const href = (p: string) => localPath(p, locale);
const discovery = discoveryMetadata[topic.slug];
const category = discoveryCategories.find((item) => item.id === discovery.category)!;
const ageLabel =
  locale === 'en' ? `Suggested ages ${discovery.minAge}+` : `建议 ${discovery.minAge} 岁起`;
---

<Base
  locale={locale}
  topic={originalTopic}
  title={context
    ? `${context.lesson.name[locale]} · ${context.book.title[locale]} | vistep.ai`
    : `${topic.name} — ${topic.title} | vistep.ai`}
  description={context
    ? `${context.curriculum.title[locale]} · ${context.lesson.name[locale]} — ${context.lesson.goal[locale]}`
    : topic.description}
>
  <main
    id="main"
    class={`lesson-wrap lesson-${topic.slug}${context ? ' curriculum-lesson' : ''}`}
    style={`--topic:${topic.color}`}
  >
    {
      context ? (
        <nav
          class="curriculum-breadcrumbs"
          aria-label={locale === 'en' ? 'Textbook location' : '教材位置'}
        >
          <a href={href('/teaching/')}>{locale === 'en' ? 'Learn' : '教学专区'}</a>
          <span aria-hidden="true">/</span>
          <a href={curriculumPath(context.curriculum.id, locale)}>
            {context.curriculum.title[locale]}
          </a>
          <span aria-hidden="true">/</span>
          <span>{context.book.title[locale]}</span>
        </nav>
      ) : (
        <div class="breadcrumbs">
          <>
            <a href={href('/#collection')}>{tr('全部探索')}</a>
            <span>/</span>
            <a href={href(`/?category=${category.id}#collection`)}>
              {category.label[locale as 'zh' | 'en']}
            </a>
            <span>/</span>
            <span>{topic.name}</span>
          </>
        </div>
      )
    }
    <header class="lesson-heading">
      <div>
        <div class="lesson-kicker">
          {
            context ? (
              <a href={curriculumSectionPath(context, locale)}>
                {curriculumSectionNumber(context)} {context.section.title[locale]}
              </a>
            ) : (
              <>
                <>
                  <span class="mono">EXPLORATION {topic.number}</span>
                  <span>·</span>
                  <span>{topic.tag}</span>
                </>
              </>
            )
          }
        </div><h1>
          {
            (context ? context.lesson.name[locale] : topic.title)
              .split(locale === 'zh' ? '，' : '\u0000')
              .map((phrase, i, parts) => (
                <span class="title-phrase">
                  {phrase}
                  {i === parts.length - 1 ? '' : '，'}
                </span>
              ))
          }
        </h1><p>{context ? context.lesson.goal[locale] : topic.description}</p>
      </div><div class="lesson-viewing">
        <span class="lesson-time"
          >{filmRunningTime(selectedWindow.end - selectedWindow.start)} {tr('演示')}</span
        ><a class="lesson-age" href={href(`/?age=${discovery.minAge}#collection`)}>{ageLabel}</a>
      </div>
    </header>
    <section class="experiment" id="experiment" aria-label={`${topic.name} ${tr('互动实验')}`}>
      <div class="browser-support-inline">{tr('互动实验需要受支持的浏览器。')}</div>
      {
        locale === 'en' ? (
          <EnglishExperiment
            dictionary={islandDictionary('experiment', topic.slug)}
            slug={topic.slug as any}
            film={films[topic.slug]}
            selection={selection}
            track={tracks[topic.slug as keyof typeof tracks]?.[locale as 'zh' | 'en']}
            client:only="react"
          >
            <div slot="fallback" class="lab-loading" role="status">
              {tr('正在准备实验…')}
            </div>
          </EnglishExperiment>
        ) : (
          <Experiment
            slug={topic.slug as any}
            film={films[topic.slug]}
            selection={selection}
            track={tracks[topic.slug as keyof typeof tracks]?.[locale as 'zh' | 'en']}
            client:only="react"
          >
            <div slot="fallback" class="lab-loading" role="status">
              {tr('正在准备实验…')}
            </div>
          </Experiment>
        )
      }<noscript
        ><div class="noscript">
          {tr('互动实验需要 JavaScript。你仍然可以阅读下方的完整讲解，理解关键步骤与模型边界。')}
        </div></noscript
      >
    </section>
    {context && <TeachingLessonContext context={context} locale={locale} />}
    <details class="lesson-transcript">
      <summary>{tr('分段讲解')}<span>{tr('阅读讲解，或回到某一步')} ＋</span></summary>
      <ol>
        {
          narration[topic.slug as keyof typeof narration].cues
            .filter(
              (cue) => cue.chapterAt >= selectedWindow.start && cue.chapterAt < selectedWindow.end,
            )
            .map((cue) => (
              <li>
                <a href={`#t=${cue.chapterAt}`} data-film-seek>
                  <time>{filmDuration(cue.chapterAt - selectedWindow.start)}</time>
                  {locale === 'zh' ? cue.title : cue.titleEn}
                </a>
                <p lang={locale === 'zh' ? 'zh-CN' : 'en'}>{cue[locale as 'zh' | 'en']}</p>
              </li>
            ))
        }
      </ol>
    </details>
    <details class="lesson-notes">
      <summary
        ><span>{tr('深入了解')}</span><span
          >{tr('模型、公式与资料来源')} <i aria-hidden="true">＋</i></span
        ></summary
      >
      <div class="lesson-reading">
        <aside class="reading-nav" aria-label={tr('专题目录')}>
          <b>{tr('沿着好奇心往下走')}</b><a href="#experiment">{tr('↑ 回到实验')}</a><a
            href="#understand">{tr('从现象到原理')}</a
          ><a href="#try">{tr('再试一个问题')}</a><a href="#deeper">{tr('深入一点')}</a><a
            href="#sources">{tr('资料与来源')}</a
          >
        </aside><article class="prose">
          <Content /><section class="source-box" id="sources">
            <h3>{tr('继续阅读 · 资料与来源')}</h3>{
              topic.sources.map((source) => (
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.title} ↗
                </a>
              ))
            }
          </section>
        </article>
      </div>
    </details>
    <section class="related-section">
      <h2>{tr('这份好奇心，还可以去哪里？')}</h2><div class="related-grid">
        {
          topic.related.map((slug) => {
            const related = localizedTopic(getTopic(slug), locale);
            const relatedCategory = discoveryCategories.find(
              (item) => item.id === discoveryMetadata[slug].category,
            )!;
            const connection = nextLearningStep(topic.slug, slug);
            return (
              <a class="related-card" href={href(`/explore/${slug}/`)}>
                <>
                  <div>
                    <>
                      <small>
                        {relatedCategory.label[locale as 'zh' | 'en']} /{' '}
                        {filmRunningTime(films[slug].duration)} ·{' '}
                        {locale === 'en'
                          ? `Suggested ${discoveryMetadata[slug].minAge}+`
                          : `建议 ${discoveryMetadata[slug].minAge} 岁起`}
                      </small>
                      <strong>{related.question}</strong>
                      {connection && (
                        <p class="related-reason">{connection.why[locale as 'zh' | 'en']}</p>
                      )}
                    </>
                  </div>
                  <span aria-hidden="true">↗</span>
                </>
              </a>
            );
          })
        }
      </div>
    </section>
  </main>
</Base>

<style>
  .curriculum-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    padding-top: 22px;
    color: #6b756c;
    font-size: 16px;
    line-height: 1.6;
  }
  .curriculum-breadcrumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .curriculum-breadcrumbs a:hover {
    color: #405d4b;
  }
  .curriculum-lesson .lesson-heading {
    padding-top: 12px;
  }
  .curriculum-lesson .lesson-kicker {
    font-size: 16px;
    letter-spacing: 0;
    text-transform: none;
  }
  .curriculum-lesson .lesson-kicker a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .curriculum-lesson .lesson-heading h1 {
    margin-top: 0;
  }
  .curriculum-lesson .lesson-heading p {
    display: block;
    margin: 12px 0 0;
    font-size: 18px;
    line-height: 1.65;
    color: #68736a;
  }
  .curriculum-lesson .lesson-time {
    font-size: 16px;
  }
  .related-reason {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: #5c7055;
  }
  .lesson-viewing {
    display: flex;
    align-items: flex-end;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 4px;
    flex-shrink: 0;
  }
  .lesson-viewing .lesson-time {
    margin: 0;
  }
  .lesson-age {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 16px;
    color: #62735b;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: #bcc7b3;
  }
  @media (max-width: 760px) {
    .lesson-viewing {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 18px;
    }
  }
</style>
