---
import { chainLoop, TAU, sprocketOutline } from '../models/mechanisms';
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const chain = chainLoop(34, 24);
const points = Array.from({ length: chain.count }, (_, i) => chain.sample(i));
const sprocket = (n: number) =>
  sprocketOutline(n)
    .map((p, i) => `${i ? 'L' : 'M'}${p.x} ${p.y}`)
    .join(' ') + 'Z';

const coverWheels = [
  { n: 34, r: chain.ra, x: -chain.distance / 2, a: chain.alpha, color: '#50605b' },
  {
    n: 24,
    r: chain.rb,
    x: chain.distance / 2,
    a: chain.alpha + (chain.lengths[0] * TAU) / 24,
    color: '#b4a57f',
  },
].map((w) => ({
  ...w,
  spokes: Array.from(
    { length: 5 },
    (_, j) =>
      `M0 0L${w.r * 0.85 * Math.cos((j * TAU) / 5)} ${w.r * 0.85 * Math.sin((j * TAU) / 5)}`,
  ).join(' '),
}));
const supportPath = [-chain.distance / 2, chain.distance / 2]
  .map((x) => `M${x} -.14V-1.42`)
  .join(' ');
const feetPath = [-chain.distance / 2, chain.distance / 2]
  .map((x) => `M${x - 0.4} -1.43h.8`)
  .join(' ');
const linkPaths = points.map((p, i) => {
  const q = points[(i + 1) % points.length];
  return `M${p.x} ${p.y}L${q.x} ${q.y}`;
});
---

<svg viewBox="0 0 480 350" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id={`metal-${slug}`} x1=".1" y1="0" x2=".85" y2="1"
      ><stop stop-color="#aeb9bb"></stop><stop offset=".32" stop-color="#e3e8e6"></stop><stop
        offset=".53"
        stop-color="#8e9b9b"></stop><stop offset=".8" stop-color="#c2ceca"></stop><stop
        offset="1"
        stop-color="#6e7d7d"></stop></linearGradient
    >
    <radialGradient id={`brass-${slug}`} cx=".3" cy=".25" r=".75"
      ><stop stop-color="#f6e7b7"></stop><stop offset=".28" stop-color="#cbb375"></stop><stop
        offset=".65"
        stop-color="#a18a51"></stop><stop offset=".9" stop-color="#746542"></stop><stop
        offset="1"
        stop-color="#b29c61"></stop></radialGradient
    >
    <filter id={`shadow-${slug}`} x="-50%" y="-50%" width="200%" height="200%"
      ><feGaussianBlur stdDeviation="8"></feGaussianBlur></filter
    >
  </defs>
  {
    slug === 'bicycle' && (
      <>
        <ellipse
          cx="245"
          cy="278"
          rx="155"
          ry="13"
          fill="#53625a"
          opacity=".12"
          filter={`url(#shadow-${slug})`}
        />
        <g transform="translate(240,177) scale(65,-65)">
          <path d={supportPath} stroke="#b0beb6" stroke-width=".23" />
          <path d={feetPath} stroke="#42584e" stroke-width=".12" stroke-linecap="round" />
          {coverWheels.map((w) => (
            <g transform={`translate(${w.x},0) rotate(${(w.a * 180) / Math.PI})`}>
              <path d={sprocket(w.n)} fill={w.color} stroke="#9caaa3" stroke-width=".012" />
              <circle r={w.r * 0.76} fill="#e5ebe1" />
              <path d={w.spokes} stroke={w.color} stroke-width=".09" />
              <circle r=".12" fill="#a8b7af" stroke="#53645b" stroke-width=".03" />
            </g>
          ))}
          <g
            transform={`translate(${-chain.distance / 2},0) rotate(${(chain.alpha * 180) / Math.PI})`}
          >
            <path d="M0 0h-1.13" stroke="#354c42" stroke-width=".12" stroke-linecap="round" />
            <rect x="-1.33" y="-.075" width=".4" height=".15" rx=".035" fill="#667970" />
          </g>
          <path
            d={linkPaths.join(' ')}
            stroke="#acbbb1"
            stroke-width=".055"
            stroke-linecap="round"
          />
          <path d={linkPaths[0]} stroke="#bf9559" stroke-width=".055" stroke-linecap="round" />
          {points.map((p) => (
            <circle cx={p.x} cy={p.y} r=".011" fill="#f0f4eb" />
          ))}
        </g>
      </>
    )
  }
  {
    slug === 'pendulum' && (
      <>
        <ellipse
          cx="250"
          cy="297"
          rx="151"
          ry="17"
          fill="#827b5d"
          opacity=".12"
          filter={`url(#shadow-${slug})`}
        />
        <>
          <path d="m97 276 219-23 76 32-219 27-76-36Z" fill="#bbbbaa" />
          <path d="m97 276 76 28 219-26v9l-219 27-76-30Z" fill="#a2a491" />
        </>
        <path d="M147 278V60m195 201V42M142 61l205-21" stroke="#536056" stroke-width="6" />
        <path d="m147 175 35 119m160-148 32 122" stroke="#8b9787" stroke-width="2" />
        <path d="m242 53 34 7v15l-34-7V53Z" fill="#b5a071" />
        <>
          <path d="m260 67 63 163" stroke="#c9c9b5" stroke-width="2.4" />
          <path d="m260 67 63 163" stroke="#696f5b" stroke-width=".6" />
        </>
        <path d="M260 72v170" stroke="#b4b59f" stroke-dasharray="3 5" />
        <path d="M169 214a162 162 0 0 0 180 1" stroke="#b8b8a0" stroke-dasharray="2 5" />
        <ellipse
          cx="300"
          cy="279"
          rx="28"
          ry="7"
          fill="#858161"
          opacity=".18"
          filter={`url(#shadow-${slug})`}
        />
        <>
          <circle cx="326" cy="237" r="28" fill={`url(#brass-${slug})`} />
          <circle cx="318" cy="225" r="9" fill="#f5eac2" opacity=".24" />
        </>
        <>
          <path d="M260 100a34 34 0 0 1 12-2" stroke="#a39264" />
          <text x="274" y="100" fill="#a9996e" font-size="13" font-style="italic">
            θ
          </text>
        </>
        <text
          x="94"
          y="328"
          fill="#9b9d82"
          font-size="8"
          font-family="sans-serif"
          letter-spacing="1.6"
        >
          POTENTIAL ⇄ KINETIC
        </text>
      </>
    )
  }
  {
    slug === 'jpeg' && (
      <>
        <ellipse
          cx="240"
          cy="279"
          rx="151"
          ry="23"
          fill="#68627c"
          opacity=".13"
          filter={`url(#shadow-${slug})`}
        />
        {[0, 1, 2].map((layer) => (
          <g
            transform={`translate(${86 + layer * 82},${103 + layer * 19}) matrix(.82,-.3,.05,.9,0,0)`}
          >
            <rect
              x="-9"
              y="-9"
              width="172"
              height="172"
              rx="1"
              fill={layer === 1 ? '#dedcea' : '#edecf1'}
              stroke="#c2becf"
            />
            {Array.from({ length: 64 }, (_, i) => {
              const x = i % 8,
                y = Math.floor(i / 8),
                v =
                  layer === 0
                    ? Math.round(140 + 90 * Math.cos((x - y) * 0.6))
                    : layer === 2
                      ? Math.round(140 + 80 * Math.cos((x - y) * 0.56))
                      : 0;
              return (
                <rect
                  x={x * 19.2}
                  y={y * 19.2}
                  width={layer === 1 ? 17.5 : 19.2}
                  height={layer === 1 ? 17.5 : 19.2}
                  fill={
                    layer === 1
                      ? x + y < 6
                        ? `rgba(127,99,140,${1 - (x + y) / 7})`
                        : '#e6e3ed'
                      : `rgb(${v + 9},${v - 4},${v + 14})`
                  }
                />
              );
            })}
          </g>
        ))}
        <>
          <path d="M341 101v-24h-51" stroke="#a398b4" />
          <text
            x="212"
            y="63"
            fill="#94859f"
            font-size="9"
            font-family="sans-serif"
            letter-spacing="1"
          >
            LESS DATA. SAME IDEA.
          </text>
        </>
        <text
          x="91"
          y="306"
          fill="#9d90ac"
          font-size="8"
          font-family="sans-serif"
          letter-spacing="1.4"
        >
          PIXELS → FREQUENCIES → PIXELS
        </text>
      </>
    )
  }
</svg>
