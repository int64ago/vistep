---
import {
  type CurriculumContext,
  curriculumSectionPath,
  curriculumSectionNumber,
  curriculumNeighbors,
  curriculumLessonPath,
} from '../../data/curricula';
import type { Locale } from '../../i18n';
import '../../styles/teaching.css';
interface Props {
  context: CurriculumContext;
  locale?: Locale;
}
const { context, locale = 'zh' } = Astro.props;
const { section, lesson } = context;
const { previous, next } = curriculumNeighbors(context);
const explanation = lesson.explanation;
---

{
  explanation && (
    <section
      class="teaching-reasoning"
      aria-label={locale === 'zh' ? '从现象得到的解释' : 'What explains the observation'}
    >
      <h2>{locale === 'zh' ? '把现象连成一个解释' : 'Connect the observations'}</h2>
      <p>{explanation.principle[locale]}</p>
      <details class="teaching-transfer">
        <summary>
          <span class="teaching-transfer-label">
            {locale === 'zh' ? '换个情境，试着解释' : 'Use the idea in a new situation'}
          </span>
          <span>{explanation.transfer.question[locale]}</span>
          <span class="teaching-transfer-action">
            <span class="teaching-transfer-closed">
              {locale === 'zh' ? '展开推理' : 'Explore the reasoning'}
            </span>
            <span class="teaching-transfer-open">
              {locale === 'zh' ? '收起推理' : 'Close the reasoning'}
            </span>
            <span class="teaching-transfer-plus" aria-hidden="true">
              ＋
            </span>
          </span>
        </summary>
        <p>{explanation.transfer.explanation[locale]}</p>
      </details>
    </section>
  )
}

<div class="teaching-lesson-context">
  <div class="teaching-lesson-location">
    <a href={curriculumSectionPath(context, locale)}>
      <span aria-hidden="true">←</span>
      <span>{curriculumSectionNumber(context)} {section.title[locale]}</span>
    </a>
    <span>{locale === 'zh' ? `教材第 ${lesson.page} 页` : `Textbook page ${lesson.page}`}</span>
  </div>
  <div class="teaching-lesson-purpose">
    {
      !explanation && (
        <p>
          <span>{locale === 'zh' ? '本节目标' : 'Learning goal'}</span>
          {lesson.goal[locale]}
        </p>
      )
    }
    <p class="teaching-lesson-original">
      <span
        >{
          lesson.titleIsOriginal === false
            ? locale === 'zh'
              ? '教材对应内容'
              : 'Textbook context'
            : locale === 'zh'
              ? '教材原名'
              : 'Textbook title'
        }</span
      >{lesson.textbookTitle[locale]}
    </p>
  </div>
</div>

<nav
  class="teaching-lesson-neighbors"
  aria-label={locale === 'zh' ? '按教材继续学习' : 'Continue in textbook order'}
>
  {
    previous ? (
      <a href={curriculumLessonPath(previous, locale)}>
        <>
          <span>{locale === 'zh' ? '← 上一项' : '← Previous'}</span>
          <strong>
            {previous.lesson.explanation?.question[locale] ?? previous.lesson.name[locale]}
          </strong>
        </>
      </a>
    ) : (
      <span />
    )
  }
  {
    next && (
      <a href={curriculumLessonPath(next, locale)}>
        <>
          <span>{locale === 'zh' ? '下一项 →' : 'Next →'}</span>
          <strong>{next.lesson.explanation?.question[locale] ?? next.lesson.name[locale]}</strong>
        </>
      </a>
    )
  }
</nav>
