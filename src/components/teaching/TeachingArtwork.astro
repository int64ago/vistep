---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const suffix = compact ? 'compact' : 'hero';
---

<svg
  class:list={['teaching-artwork', { 'is-compact': compact }]}
  viewBox="0 0 460 330"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient
      id={`teaching-paper-${suffix}`}
      x1="80"
      y1="140"
      x2="330"
      y2="300"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fffef6"></stop><stop offset="1" stop-color="#e2e8d9"></stop>
    </linearGradient>
    <linearGradient
      id={`teaching-glass-${suffix}`}
      x1="191"
      y1="100"
      x2="285"
      y2="170"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#f4f9e9" stop-opacity=".85"></stop><stop
        offset=".6"
        stop-color="#bed5c3"
        stop-opacity=".25"></stop><stop offset="1" stop-color="#96b4a0" stop-opacity=".65"></stop>
    </linearGradient>
    <radialGradient id={`teaching-cell-${suffix}`}>
      <stop stop-color="#e7edc9"></stop><stop offset="1" stop-color="#b5cda5"></stop>
    </radialGradient>
  </defs>
  <ellipse cx="230" cy="286" rx="172" ry="17" fill="#677c61" opacity=".08"></ellipse>
  <path
    d="M51 163Q135 139 230 169Q320 140 409 163L394 279Q309 256 230 286Q146 257 65 280Z"
    fill="#b4c4ac"
    opacity=".8"></path>
  <path
    d="M53 153Q136 129 230 160Q318 129 407 153L393 269Q310 247 230 278Q145 247 67 270Z"
    fill={`url(#teaching-paper-${suffix})`}
    stroke="#cad5bd"></path>
  <path d="M230 160V278M58 160Q137 138 224 166M237 166Q319 139 401 160" stroke="#d2dbc5"></path>
  <path
    d="M85 233Q143 225 199 245M83 244Q140 237 177 248M263 246Q325 225 371 237M263 257Q313 240 347 248"
    stroke="#b6c7aa"
    stroke-width="3"
    stroke-linecap="round"></path>
  <path d="M301 254v33l10-7 9 7v-36" fill="#b1bf98"></path>
  <!-- A connected pendulum, a glass vessel and a cell offer three reading paths. -->
  <path d="M85 204H167M100 203V67H153" stroke="#748a73" stroke-width="7" stroke-linecap="round"
  ></path>
  <circle cx="145" cy="69" r="4" fill="#a7b79b"></circle>
  <path d="M145 73 176 155" stroke="#778c74" stroke-width="1.8"></path>
  <path d="M145 83V177M111 160Q145 186 179 160" stroke="#a2b59a" stroke-dasharray="3 6"></path>
  <circle cx="179" cy="165" r="15" fill="#b3a37b" stroke="#8d8767"></circle>
  <ellipse cx="175" cy="161" rx="5" ry="7" fill="#d5c9a6" opacity=".8"></ellipse>
  <path
    d="M222 75H251M225 76V116L197 180Q193 193 204 196H272Q283 193 279 180L248 116V76"
    fill={`url(#teaching-glass-${suffix})`}
    stroke="#8eab95"
    stroke-width="1.7"
    stroke-linejoin="round"></path>
  <path d="M211 150H263L277 182Q279 191 270 192H206Q198 192 201 182Z" fill="#be9a61" opacity=".42"
  ></path>
  <ellipse cx="237" cy="150" rx="26" ry="5" fill="#dcc08a" opacity=".45"></ellipse>
  <path
    d="M230 86V116L207 173M265 175h9M258 160h10"
    stroke="#edf2dc"
    stroke-width="3"
    stroke-linecap="round"></path>
  <path
    d="M332 94C371 87 398 119 390 151C384 184 351 207 324 190C297 176 288 151 298 126C306 107 315 98 332 94Z"
    fill={`url(#teaching-cell-${suffix})`}
    stroke="#8faa80"
    stroke-width="2"></path>
  <path
    d="M334 103C365 97 388 123 381 150C376 177 352 196 328 182C306 169 298 149 308 129C315 112 322 106 334 103Z"
    stroke="#9db98a"></path>
  <ellipse
    cx="345"
    cy="143"
    rx="23"
    ry="27"
    transform="rotate(24 345 143)"
    fill="#d8d7b7"
    stroke="#b7b68f"></ellipse>
  <ellipse cx="352" cy="140" rx="9" ry="11" fill="#9fa18d" opacity=".65"></ellipse>
  <g fill="#8da779" stroke="#739364" stroke-width="1.2">
    <ellipse cx="327" cy="117" rx="9" ry="5" transform="rotate(-30 327 117)"></ellipse>
    <ellipse cx="373" cy="133" rx="9" ry="5" transform="rotate(75 373 133)"></ellipse>
    <ellipse cx="350" cy="178" rx="9" ry="5" transform="rotate(12 350 178)"></ellipse>
    <ellipse cx="315" cy="155" rx="9" ry="5" transform="rotate(65 315 155)"></ellipse>
  </g>
  <path d="m321 118 9-4m41 13 3 11m-30 50 12 2m-43-39 4 10" stroke="#c8d8ad" stroke-width="1.3"
  ></path>
</svg>
