---
import Base from '../../layouts/Base.astro';
import {
  curricula,
  curriculumPath,
  curriculumLessonPath,
  getCurriculumLessons,
} from '../../data/curricula';
import { featuredTeachingLessons } from '../../data/teaching-explanations';
import type { Locale } from '../../i18n';
import TeachingArtwork from './TeachingArtwork.astro';
import TeachingBookMark from './TeachingBookMark.astro';
import '../../styles/teaching.css';
interface Props {
  locale?: Locale;
}
const { locale = 'zh' } = Astro.props;
const featured = featuredTeachingLessons.map((id) =>
  curricula
    .flatMap((curriculum) => getCurriculumLessons(curriculum))
    .find(({ lesson }) => lesson.experimentId === id)!,
);
const copy = {
  zh: {
    title: '教学专区',
    heading: ['从「怎么会这样」，', '走到「原来如此」。'],
    intro: '从教材里的一个现象出发。跟踪看不见的过程，找到支撑解释的证据，再用原理回答一个新问题。',
    questions: '先带着一个问题出发',
    questionsNote: '运动、光与细胞，各有一条追问的线索。',
    collection: '选择你的教材',
    collectionNote: '章节有顺序，好奇心有去处。',
    action: '打开教材目录',
    available: '已收录',
    experiments: '个学习位置',
    approach: '现象是起点，理解才是目的。',
    approachText:
      '沿教材的学习顺序，把观察、证据和理论联系起来。改变一个条件，看看原来的解释还能不能成立。教材原名和页码始终保留，方便回到课堂。',
    lesson: '正在展开',
  },
  en: {
    title: 'Learn',
    heading: ['Start with “why?”.', 'See how it makes sense.'],
    intro:
      'Start with an observation from your textbook. Follow the hidden process, find the evidence, and use the explanation to answer a new question.',
    questions: 'Begin with a question',
    questionsNote: 'Three ways into motion, light and living cells.',
    collection: 'Choose your textbook',
    collectionNote: 'A clear sequence. Room for curiosity.',
    action: 'Open the chapter guide',
    available: '',
    experiments: 'learning entries',
    approach: 'An observation starts the story.',
    approachText:
      'Follow textbook order while connecting observations, evidence and theory. Change a condition and see whether the explanation still holds. Original titles and page references keep the connection to your classroom.',
    lesson: 'Now exploring',
  },
}[locale];
---

<Base
  locale={locale}
  title={`${copy.title} | vistep.ai`}
  description={copy.intro}
  languageSwitchPath="/teaching/"
>
  <main id="main" class="teaching-wrap teaching-home">
    <header class="teaching-hero">
      <div class="teaching-hero-copy">
        <p class="teaching-eyebrow"><span></span>{copy.title}</p>
        <h1>{copy.heading.map((line) => <span>{line}</span>)}</h1>
        <p class="teaching-intro">{copy.intro}</p>
      </div>
      <div class="teaching-hero-art"><TeachingArtwork /></div>
    </header>

    <section class="teaching-questions" aria-labelledby="teaching-questions-title">
      <div class="teaching-section-label">
        <h2 id="teaching-questions-title">{copy.questions}</h2><p>{copy.questionsNote}</p>
      </div>
      <div class="teaching-question-list">
        {
          featured.map((context) => (
            <a class="teaching-question" href={curriculumLessonPath(context, locale)}>
              <span>
                {context.curriculum.subject[locale]} · {context.section.title[locale]}
              </span>
              <strong>{context.lesson.explanation!.question[locale]}</strong>
              <p>{context.lesson.explanation!.lead[locale]}</p>
              <span class="teaching-question-link">
                {locale === 'zh' ? '跟着问题看下去' : 'Follow the question'}{' '}
                <span aria-hidden="true">↗</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>
    <section class="teaching-collection" aria-labelledby="teaching-textbooks">
      <div class="teaching-section-label">
        <h2 id="teaching-textbooks">{copy.collection}</h2>
        <p>{copy.collectionNote}</p>
      </div>
      <div class="teaching-textbooks">
        {
          curricula.map((curriculum) => {
            const lessons = getCurriculumLessons(curriculum);
            return (
              <a class="teaching-textbook" href={curriculumPath(curriculum.id, locale)}>
                <TeachingBookMark curriculum={curriculum} locale={locale} />
                <div class="teaching-textbook-info">
                  <div class="teaching-textbook-meta">
                    <>
                      <span>{curriculum.stage[locale]}</span>
                      <span>{curriculum.publisher[locale]}</span>
                    </>
                  </div>
                  <h3>{curriculum.title[locale]}</h3>
                  <p>{curriculum.description[locale]}</p>
                  <div class="teaching-textbook-status">
                    <span class="teaching-status-dot" />
                    {copy.available} {lessons.length} {copy.experiments}
                    <span class="teaching-status-separator">·</span>
                    <span>
                      {locale === 'zh'
                        ? `${curriculum.books.length} 册教材`
                        : `${curriculum.books.length} books`}
                    </span>
                  </div>
                </div>
                <div class="teaching-textbook-action">
                  <>
                    <span>{copy.action}</span>
                    <span class="teaching-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    <aside class="teaching-approach">
      <span class="teaching-approach-index" aria-hidden="true">01 → 02 → 03</span>
      <div><h2>{copy.approach}</h2><p>{copy.approachText}</p></div>
    </aside>
  </main>
</Base>
