    x="16"
    y="68"
    width="8"
    height="77"
    rx="3"
    fill="#aeb99f"></rect><rect x="280" y="68" width="8" height="77" rx="3" fill="#aeb99f"></rect>{
    [44, 79, 114, 149, 184, 219, 254].map((x) => (
      <g>
        <>
          <path
            d={`M${x - 4} 58h8${!positiveBelow ? `M${x} 54v8` : ''}`}
