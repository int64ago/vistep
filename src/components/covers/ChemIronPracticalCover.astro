---
import { practicalRouteGeometry, practicalFrame } from '../../models/chem-iron-practical';
const map = practicalRouteGeometry(4, true, 640);
const receive = map.records.find((r) => r.chapter === 3)!;
const donate = map.records.find((r) => r.chapter === 4)!;
const zinc = practicalFrame(3, 1, 0, 640);
const permanganate = practicalFrame(4, 1, 0, 640);
---

<svg viewBox="0 0 640 400" aria-hidden="true">
  <defs
    ><linearGradient id="ipx-cover-bg" x2="1" y2="1"
      ><stop stop-color="#edf0e2"></stop><stop offset="1" stop-color="#dce6db"
      ></stop></linearGradient
    ></defs
  >
  <rect width="640" height="400" fill="url(#ipx-cover-bg)"></rect>
  <ellipse cx="320" cy="327" rx="232" ry="27" fill="#8c9e7b" opacity=".11"></ellipse>
  <path d="M73 75q48-14 94 4l-7 56q-50 7-94-1Z" fill="#b5c2bc" stroke="#8b9c92" stroke-width="2"
  ></path>
  <text x="115" y="109" text-anchor="middle" fill="#5a716a" font-size="30">Zn</text>
  <g transform="translate(518 99)"
    ><path d="M0 0L-28-22M0 0L28-22M0 0L-28 22M0 0L28 22" stroke="#9a789b" stroke-width="3"
    ></path><circle r="17" fill="#8d6f96"></circle>{
      [-1, 1].flatMap((x) =>
        [-1, 1].map((y) => <circle cx={x * 28} cy={y * 22} r="12" fill="#bc8b7f" />),
      )
    }</g
  >
  <g transform="translate(0 116)">
    {
      [receive, donate].map((r, i) => {
        const a = r.fromPoint,
          b = r.toPoint,
          dir = Math.sign(b.x - a.x);
        return (
          <g>
            <>
              <path
                d={`M${a.x + 32 * dir} ${a.y}C${a.x + 62 * dir} 30 ${b.x - 62 * dir} 30 ${b.x - 32 * dir} ${b.y}`}
                fill="none"
                stroke={i ? '#b18c43' : '#6f9589'}
                stroke-width="5"
                stroke-linecap="round"
              />
              <path
                d={`M${b.x - 32 * dir} ${b.y}l${-12 * dir} -8m${12 * dir} 8l${-4 * dir} -14`}
                stroke={i ? '#b18c43' : '#6f9589'}
                stroke-width="3"
                fill="none"
              />
            </>
          </g>
        );
      })
    }
    {
      map.nodes.map((n) => (
        <g>
          <>
            <circle
              cx={n.x}
              cy={n.y}
              r={n.oxidation === 2 ? 42 : 33}
              fill={n.oxidation === 2 ? '#d7e7da' : n.oxidation === 3 ? '#e9d9b8' : '#d8dfd2'}
              stroke="#99ae93"
              stroke-width="2"
            />
            <text x={n.x} y={n.y + 9} text-anchor="middle" font-size="27" fill="#5b705e">
              {n.oxidation === 0 ? 'Fe⁰' : n.oxidation === 2 ? 'Fe²⁺' : 'Fe³⁺'}
            </text>
          </>
        </g>
      ))
    }
  </g>
  <text x="160" y="310" text-anchor="middle" font-size="25" fill="#628578"
    >{zinc.credits.length} e⁻</text
  >
  <text x="481" y="310" text-anchor="middle" font-size="25" fill="#997733"
    >5Fe · {permanganate.credits.length}e⁻</text
  >
  <path d="M82 349H558" stroke="#a5b59a" opacity=".4"></path>
</svg>
