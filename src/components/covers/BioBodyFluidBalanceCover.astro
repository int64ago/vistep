---
import { aqpInsertion, waterMarkers } from '../../models/bio-body-fluid-balance';
const g = aqpInsertion(1, 400);
const waters = waterMarkers(0.53, 1, 400);
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#f0f3e9"></rect>
  <rect x="20" y="24" width={g.apical - 20} height="182" rx="18" fill="#d9e8eb"></rect>
  <rect x={g.apical} y="24" width={g.basal - g.apical} height="182" fill="#ecdfc2"></rect>
  <rect x={g.basal} y="24" width={380 - g.basal} height="182" rx="18" fill="#d9e5ce"></rect>
  <path
    d={`M${g.apical} 24V121M${g.apical} 143V206M${g.basal} 24V121M${g.basal} 143V206`}
    fill="none"
    stroke="#b49a6e"
    stroke-width="6"></path>
  {
    [g.apical, g.basal].map((x) => (
      <path
        d={`M${x - 6} 111V123M${x + 6} 111V123M${x - 6} 141V153M${x + 6} 141V153`}
        stroke="#60898c"
        stroke-width="7"
        stroke-linecap="round"
        fill="none"
      />
    ))
  }
  {
    [0, 1].map((region) =>
      Array.from({ length: region ? 6 : 2 }, (_, i) => (
        <rect
          x={(region ? g.basal + 24 : 40) + (i % 2) * 18}
          y={48 + Math.floor(i / 2) * 18}
          width="5"
          height="5"
          rx="1.5"
          fill="#a58b61"
        />
      )),
    )
  }
  {
    waters.map((v, i) => (
      <circle
        cx={v.x}
        cy={v.y}
        r="6"
        fill={i ? '#e6f1f4' : '#81a8bf'}
        stroke="#4f7c93"
        stroke-width="2"
      />
    ))
  }
  <text
    x={g.apical}
    y="101"
    text-anchor="middle"
    font-family="sans-serif"
    font-size="18"
    fill="#566b64">AQP2</text
  >
  <path
    d="M158 57H243m-8-6 8 6-8 6M243 77H158m8-6-8 6 8 6"
    fill="none"
    stroke="#7c9cac"
    stroke-width="2"
    stroke-linecap="round"></path>
</svg>
