---
import { PERIOD_3 } from '../../models/chem-periodic-patterns';
---

<svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
  ><rect width="640" height="400" fill="#eef0e5"></rect><path
    d="M90 315H560"
    stroke="#bdc8ae"
    stroke-width="2"></path>{
    PERIOD_3.map((e, i) => (
      <g>
        <>
          <rect
            x={92 + i * 58}
            y={315 - e.ie * 13}
            width="34"
            height={e.ie * 13}
            rx="10"
            fill={i === 2 || i === 5 ? '#b99774' : '#94aa7c'}
          />
          <text x={109 + i * 58} y="349" text-anchor="middle" font-size="20" fill="#596d4f">
            {e.symbol}
          </text>
        </>
      </g>
    ))
  }<path
    d="M180 202L235 237M353 156L409 158"
    fill="none"
    stroke="#8f7155"
    stroke-width="3"
    stroke-linecap="round"></path><text x="88" y="68" font-size="24" fill="#566c4c">Na → Ar</text
  ></svg
>
