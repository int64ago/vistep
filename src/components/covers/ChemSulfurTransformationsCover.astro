---
import { copperNetAtoms, sulfurElectronLedger } from '../../models/chem-sulfur-transformations';
const atoms = copperNetAtoms(1, 540);
const ledger = sulfurElectronLedger('copper', 1, 260);
const color = { Cu: '#ad7b58', S: '#cfb669', O: '#a6b5a5', H: '#e4e6da' };
---

<svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="640" height="400" fill="#eff1e7"></rect>
  <path d="M110 100Q320 40 526 100" fill="none" stroke="#d5dacb" stroke-width="2"></path>
  <g transform="translate(50 65)">
    <rect
      x="77"
      y="17"
      width="118"
      height="143"
      rx="44"
      fill="#e1e9df"
      stroke="#bdc9b8"
      stroke-dasharray="4 5"></rect>
    <rect
      x="347"
      y="4"
      width="118"
      height="103"
      rx="43"
      fill="#f1e9cb"
      stroke="#caba83"
      stroke-dasharray="4 5"></rect>
    <text x="135" y="-1" text-anchor="middle" font-size="25" fill="#657557">CuSO₄</text>
    <text x="405" y="-13" text-anchor="middle" font-size="25" fill="#657557">SO₂</text>
    {
      atoms.atoms.map((a) => (
        <g>
          <circle
            cx={a.x}
            cy={a.y}
            r={a.element === 'H' ? 12 : a.element === 'O' ? 15 : 23}
            fill={color[a.element as keyof typeof color]}
            stroke="#a5b397"
          />
          <text
            x={a.x}
            y={a.y + 6}
            text-anchor="middle"
            font-size={a.element === 'H' ? 17 : 20}
            fill="#617258"
          >
            {a.element}
          </text>
        </g>
      ))
    }
    <text x="135" y="185" text-anchor="middle" font-size="23" fill="#6b7b5f">S: +6</text>
    <text x="405" y="126" text-anchor="middle" font-size="23" fill="#6b7b5f">S: +4</text>
  </g>
  <path
    d="M195 323Q315 270 448 323"
    fill="none"
    stroke="#89a6a4"
    stroke-width="2"
    stroke-dasharray="5 7"></path>
  <rect x="282" y="286" width="76" height="42" rx="21" fill="#e1ebe3" stroke="#91aaa5"></rect>
  <text x="320" y="314" text-anchor="middle" font-size="26" fill="#64878a"
    >{ledger.accepted} e⁻</text
  >
</svg>
