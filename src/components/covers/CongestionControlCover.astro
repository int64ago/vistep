---
import { congestionRun } from '../../models/congestion-control';
const { color = '#99a57a' } = Astro.props,
  run = congestionRun();
const points = run.history
  .map((r, i) => `${25 + (i / 27) * 350},${185 - (r.before / 20) * 145}`)
  .join(' ');
---

<svg viewBox="0 0 400 230" width="400" height="230" fill="none" aria-hidden="true">
  <path d="M25 45V185H376" stroke={color} opacity=".4"></path>
  {
    [4, 8, 12, 16].map((v) => (
      <path d={`M25 ${185 - (v / 20) * 145}H375`} stroke={color} opacity=".12" />
    ))
  }
  <polyline points={points} stroke={color} stroke-width="3" stroke-linejoin="round"></polyline>
  {
    run.history
      .filter((r) => r.dropped.length)
      .map((r) => (
        <circle
          cx={25 + (r.round / 27) * 350}
          cy={185 - (r.before / 20) * 145}
          r="4"
          fill="#bd935a"
        />
      ))
  }
  <text x="26" y="28" font-family="monospace" font-size="16" fill={color}
    >ACK → WINDOW → QUEUE → LOSS</text
  >
  <text x="26" y="216" font-family="monospace" font-size="16" fill="#aa8953">+1/W · ×1/2</text>
</svg>
