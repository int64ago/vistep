---
const coil = Array.from({ length: 241 }, (_, i) => {
  const q = i / 240;
  return `${i ? 'L' : 'M'}${87 + 80 * q + 4 * Math.cos(q * 16 * Math.PI)} ${100 + 20 * Math.sin(q * 16 * Math.PI)}`;
}).join(' ');
