---
import {
  DIFFERENTIAL as D,
  differentialMotion,
  differentialBevel,
  differentialBevelOutline,
  differentialFrame,
  differentialGearPhase,
  type DifferentialVector,
  type DifferentialGearId,
} from '../../models/differential';
import { svgPoint } from '../../lib/svg-cover';
interface Props {
  color?: string;
}
const { color = '#69838a' } = Astro.props;
const m = differentialMotion('turn', 0.9, 1.7, 2);
const rows: DifferentialVector[] = [
  [0.952, 0, -0.305],
  [-0.065, 0.978, -0.202],
];
const dot = (a: DifferentialVector, b: DifferentialVector) =>
  a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
const sub = (a: DifferentialVector, b: DifferentialVector): DifferentialVector => [
  a[0] - b[0],
  a[1] - b[1],
  a[2] - b[2],
];
const cross = (a: DifferentialVector, b: DifferentialVector): DifferentialVector => [
  a[1] * b[2] - a[2] * b[1],
  a[2] * b[0] - a[0] * b[2],
  a[0] * b[1] - a[1] * b[0],
];
const project = (p: DifferentialVector) => [200 + 43 * dot(rows[0], p), 116 - 43 * dot(rows[1], p)];
const point = (p: DifferentialVector) => svgPoint(project(p));
// Orthographic view direction toward the camera (null space of the projection; depth grows with z).
const toward = cross(rows[0], rows[1]);
const faces: { points: string; depth: number; fill: string }[] = [];
for (const id of ['left', 'right', 'upper', 'lower'] as DifferentialGearId[]) {
  const side = id === 'left' || id === 'right',
    g = differentialBevel(side ? 'side' : 'pinion'),
    o = differentialBevelOutline(g).filter((_, i) => i % 4 === 0),
    phase = differentialGearPhase(id, m);
  const toWorld = (p: (typeof o)[number], r: number) => {
    const a = p.azimuth + phase;
    return differentialFrame(
      [
        r * Math.sin(p.polar) * Math.cos(a),
        r * Math.sin(p.polar) * Math.sin(a),
        r * Math.cos(p.polar),
      ],
      id,
      m.carrierAngle,
    );
  };
  const origin = differentialFrame([0, 0, 0], id, m.carrierAngle),
    axis = sub(differentialFrame([0, 0, 1], id, m.carrierAngle), origin);
  const radial = (p: DifferentialVector) => {
    const r = sub(p, origin),
      along = dot(r, axis);
    return sub(r, [axis[0] * along, axis[1] * along, axis[2] * along]);
  };
  // The outline is monotonic in azimuth, so every strip face is wound the same way. Orient the
  // strip from a pure cone segment (both ends at one polar angle), where outward is radial for the
  // tooth band and axial for the end face; then keep only faces turned toward the camera. The far
  // half of each gear hides behind its own body, and the inner openings are edge-on in this view.
  const strip = o.map((p, i) => {
    const next = o[(i + 1) % o.length],
      a = toWorld(p, g.inner),
      b = toWorld(next, g.inner),
      c = toWorld(next, g.outer),
      d = toWorld(p, g.outer),
      hub = differentialFrame([0, 0, g.outer], id, m.carrierAngle);
    return {
      band: [a, b, c, d],
      end: [d, c, hub],
      bandNormal: cross(sub(b, a), sub(d, a)),
      endNormal: cross(sub(c, d), sub(hub, d)),
      cone: p.polar === next.polar,
    };
  });
  const reference = strip.find((f) => f.cone)!;
  const bandSign = Math.sign(dot(reference.bandNormal, radial(reference.band[0]))),
    endSign = Math.sign(dot(reference.endNormal, axis));
  const depth = (corners: DifferentialVector[]) =>
    corners.reduce((sum, p) => sum + p[2], 0) / corners.length;
  for (const f of strip) {
    if (Math.sign(dot(f.bandNormal, toward)) === bandSign)
      faces.push({
        points: f.band.map(point).join(' '),
        depth: depth(f.band),
        fill: side ? (id === 'left' ? '#bc9677' : '#8aafb8') : '#c89b66',
      });
    if (Math.sign(dot(f.endNormal, toward)) === endSign)
      faces.push({
        points: f.end.map(point).join(' '),
        depth: depth(f.end),
        fill: side ? '#6e8992' : '#9e784f',
      });
  }
}
faces.sort((a, b) => a.depth - b.depth);
// Painter's order is preserved; consecutive faces of one material share a group.
const runs: { fill: string; points: string[] }[] = [];
for (const face of faces) {
  const last = runs.at(-1);
  if (last?.fill === face.fill) last.points.push(face.points);
  else runs.push({ fill: face.fill, points: [face.points] });
}
const ring = (x: number, r: number) =>
  Array.from({ length: 65 }, (_, i) =>
    point([x, r * Math.cos((i * Math.PI) / 32), r * Math.sin((i * Math.PI) / 32)]),
  ).join(' ');
---

<svg
  viewBox="0 0 400 230"
  width="400"
  height="230"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs
    ><radialGradient id="diff-cover-bg"
      ><stop stop-color="#29434f"></stop><stop offset="1" stop-color="#182d38"
      ></stop></radialGradient
    ></defs
  >
  <rect width="400" height="230" fill="url(#diff-cover-bg)"></rect>
  <path d="M30 202H367" stroke="#52717a" stroke-width="4" opacity=".5"></path>
  <path
    d={`M${point([-3.6, 0, 0])}L${point([-D.axleStart, 0, 0])}M${point([D.axleStart, 0, 0])}L${point([3.6, 0, 0])}`}
    stroke="#b9c9ca"
    stroke-width="7"></path>
  {
    [-1, 1].map((sign) => (
      <g>
        <>
          <polyline
            points={ring(sign * D.carrierHalfLength, 1.62)}
            stroke={color}
            stroke-width="5"
          />
          <path
            d={`M${point([sign * 2.1, 0, 0])}L${point([sign * 2.1, -1.9, 0])}`}
            stroke={color}
            stroke-width="9"
          />
          <polyline points={ring(sign * 3.6, 0.69)} stroke="#111f27" stroke-width="12" />
          <polyline points={ring(sign * 3.6, 0.45)} stroke="#a5b8bd" stroke-width="5" />
        </>
      </g>
    ))
  }
  <path
    d={`M${point(differentialFrame([0, 0, -1.65], 'upper', m.carrierAngle))}L${point(differentialFrame([0, 0, 1.65], 'upper', m.carrierAngle))}`}
    stroke="#aabec0"
    stroke-width="5"></path>
  <g stroke-width=".15">
    {
      runs.map((run) => (
        <g fill={run.fill} stroke={run.fill}>
          {run.points.map((points) => (
            <polygon points={points} />
          ))}
        </g>
      ))
    }
  </g>
  {
    [Math.PI / 4, (5 * Math.PI) / 4].map((a) => (
      <path
        d={`M${point([-1.48, 1.58 * Math.cos(a + m.carrierAngle), 1.58 * Math.sin(a + m.carrierAngle)])}L${point([1.48, 1.58 * Math.cos(a + m.carrierAngle), 1.58 * Math.sin(a + m.carrierAngle)])}`}
        stroke={color}
        stroke-width="4"
      />
    ))
  }
  <path d="M169 33h62m-6-4 6 4-6 4" stroke="#c9b28d" stroke-width="1.5"></path>
  <circle cx="200" cy="33" r="3.5" fill="#dac39a"></circle>
</svg>
