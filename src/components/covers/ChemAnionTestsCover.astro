---
import { anionEvidence } from '../../models/chem-anion-tests';
const state = anionEvidence('sulfate', 2, 2);
---

<svg viewBox="0 0 640 400" fill="none" aria-hidden="true"
  ><rect width="640" height="400" fill="#e9eee6"></rect><ellipse
    cx="320"
    cy="337"
    rx="230"
    ry="20"
    fill="#718875"
    opacity=".08"></ellipse>{
    [0, 1, 2].map((i) => (
      <g transform={`translate(${155 + i * 155},80)`}>
        <path d="M-35 80V205a35 35 0 0 0 70 0V80Z" fill="#bdd4c5" opacity=".3" />
        {Array.from({ length: 20 }, (_, j) => (
          <ellipse
            cx={-25 + ((j * 13) % 50)}
            cy={213 + ((j * 7) % 17)}
            rx="6"
            ry="3"
            fill="#fffdf0"
            opacity={i === 2 ? state.carbonateSolid : state.targetSolid}
          />
        ))}
        {i === 2 &&
          [0, 1, 2, 3].map((j) => (
            <circle cx={-12 + ((j * 17) % 24)} cy={185 - j * 30} r={3 + (j % 2)} stroke="#96ad9c" />
          ))}
      </g>
    ))
  }<path d="M152 40L155 55L158 40M307 40L310 55L313 40M462 40L465 55L468 40" fill="#aa9e79"
  ></path></svg
>
