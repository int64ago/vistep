---
import { soilExtraction } from '../../models/bio-community-survey';
const cells = soilExtraction(0.62);
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#eff2e6"></rect>
  <g transform="translate(200 -15) scale(.76)">
    <path d="M-39 44q39-39 78 0Z" fill="#a7b9ac" stroke="#8ca093" stroke-width="2"></path><ellipse
      cy="47"
      rx="8"
      ry="7"
      fill="#e3d89a"></ellipse>
    <path
      d="M-58 94l14 62h88l14-62"
      fill="#c4ad90"
      fill-opacity=".4"
      stroke="#ab9276"
      stroke-width="2"></path><ellipse cy="94" rx="58" ry="8" fill="none" stroke="#ab9276"
    ></ellipse>
    <path d="M-34 110h68v40h-68Z" fill="#b4a078"></path>
    {
      Array.from({ length: 8 }, (_, i) => (
        <path d={`M${-28 + i * 8} 150v6`} stroke="#8b9285" stroke-width="1.3" />
      ))
    }
    <path
      d="M-50 156L-7 218v31h14v-31l43-62"
      fill="#c9d9cf"
      fill-opacity=".3"
      stroke="#9eb4a4"
      stroke-width="2"></path>
    <path d="M-20 242v44q0 13 20 13t20-13v-44" fill="#e3eae0" stroke="#9eb4a4" stroke-width="2"
    ></path><path d="M-18 277h36v9q0 11-18 11t-18-11Z" fill="#b6d1cb"></path>
    {
      cells.map((c) => (
        <g>
          <>
            <ellipse
              cx={c.x}
              cy={c.y}
              rx="1.7"
              ry="2.3"
              fill={
                c.group === 'mite' ? '#8d7867' : c.group === 'springtail' ? '#7e8770' : '#a99d71'
              }
            />
            <path d={`M${c.x - 1} ${c.y}l-2-1m4 1 2-1`} stroke="#8d7867" stroke-width=".5" />
          </>
        </g>
      ))
    }
  </g>
  <path
    d="M102 88q-19 35 0 70m196-70q19 35 0 70"
    fill="none"
    stroke="#cbd4bb"
    stroke-width="2"
    stroke-dasharray="5 7"></path>
</svg>
