---
import { copper } from '../../models/chem-coordination-colors';
const states = [copper('precipitate', 1), copper('ammine', 1), copper('crystallize', 1)];
const color = (s: (typeof states)[number]) =>
  `rgb(${[229, 238, 232].map((v, i) => Math.round(v + ([147, 196, 214][i] - v) * s.aqua + ([62, 93, 176][i] - v) * s.complex)).join(' ')})`;
---

<svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
  ><rect width="640" height="400" fill="#e7ede4"></rect>{
    states.map((s, i) => (
      <g transform={`translate(${101 + i * 190} 0)`}>
        <>
          <defs>
            <clipPath id={`ccol-cover-${i}`}>
              <path d="M-43 66 V299 Q-43 332 0 332 Q43 332 43 299 V66Z" />
            </clipPath>
          </defs>
          <g clip-path={`url(#ccol-cover-${i})`}>
            <ellipse
              cx="0"
              cy="160"
              rx="43"
              ry="5"
              fill={color(s)}
              stroke="#8ba7a4"
              stroke-opacity=".4"
            />
            {Array.from({ length: 23 }, (_, j) => {
              const x = -30 + ((j * 37) % 59),
                y = 305 + ((j * 19) % 18),
                r = 6 * Math.cbrt(s.hydroxide + s.crystal);
              return i === 2 ? (
                <path
                  d={`M${x - r} ${y} L${x} ${y - r * 1.7} L${x + r} ${y} L${x} ${y + r * 0.6}Z`}
                  fill="#365c9a"
                  stroke="#234c7c"
                  stroke-width=".5"
                />
              ) : (
                <ellipse cx={x} cy={y} rx={r} ry={r * 0.7} fill="#a5cbdc" />
              );
            })}
          </g>
          <path
            d="M-46 64 V299 Q-46 336 0 336 Q46 336 46 299 V64"
            fill="#d4e4da"
            fill-opacity=".08"
            stroke="#92aba0"
            stroke-width="2"
          />
          <ellipse cx="0" cy="64" rx="46" ry="6" fill="none" stroke="#92aba0" stroke-width="2" />
          <path d="M-37 77 V285" fill="none" stroke="#fff" stroke-opacity=".65" stroke-width="4" />
        </>
      </g>
    ))
  }{
    [180, 370].map((x) => (
      <path
        d={`M${x - 10} 220 H${x + 20} L${x + 13} 214 M${x + 20} 220 L${x + 13} 226`}
        fill="none"
        stroke="#ad9665"
        stroke-width="2"
      />
    ))
  }</svg
>
