---
import { computeCover } from '../../models/cpu-gpu-npu-cover';
interface Props {
  color?: string;
}
const { color = '#6b999b' } = Astro.props;
const cover = computeCover();
---

<svg viewBox="0 0 400 230" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#eef2e9"></rect>
  <path
    d="M26 193C80 182 113 206 164 193S260 179 374 192"
    stroke="#8baa99"
    stroke-opacity=".3"
    stroke-width="2"></path>
  <g font-family="sans-serif" font-size="15" fill="#5b7c71" text-anchor="middle"
    ><text x="72" y="43">CPU</text><text x="194" y="43">GPU</text><text x="325" y="43">NPU</text></g
  >
  <rect x="25" y="61" width="94" height="111" rx="18" fill="#f8f9ef" stroke="#b7c9b2"></rect>
  <path d="M48 77H97M48 84H84" stroke="#c2cbb5" stroke-width="3" stroke-linecap="round"></path>
  <rect
    x="42"
    y="98"
    width="60"
    height="52"
    rx="12"
    fill="#e4d4ba"
    stroke="#b9824d"
    stroke-opacity=".4"></rect>
  <text x="72" y="119" text-anchor="middle" font-family="sans-serif" font-size="12" fill="#9b754f"
    >{cover.cpu.a} × {cover.cpu.b}</text
  >
  <text x="72" y="141" text-anchor="middle" font-family="sans-serif" font-size="22" fill="#7f6142"
    >{cover.cpu.after}</text
  >
  <rect x="143" y="61" width="102" height="111" rx="18" fill="#f8f9ef" stroke="#b7c9b2"></rect>
  <path d="M156 80H231" stroke={color} stroke-opacity=".6" stroke-width="2"></path>
  {
    cover.gpu.map((p, index) => (
      <g>
        <>
          <path d={`M${157 + index * 24} 80V97`} stroke="#8da88c" />
          <rect x={149 + index * 24} y="98" width="18" height="48" rx="6" fill="#d2e1ce" />
          <text
            x={158 + index * 24}
            y="127"
            text-anchor="middle"
            font-family="sans-serif"
            font-size="14"
            fill="#4f7969"
          >
            {p.after}
          </text>
          <path d={`M${157 + index * 24} 146V158`} stroke="#8da88c" />
        </>
      </g>
    ))
  }
  <g transform="translate(267 61) scale(.29)">
    {
      Array.from({ length: 4 }, (_, i) => (
        <g>
          <>
            <path
              d={`M0 ${60 + i * 96}H400`}
              stroke="#6f9a9a"
              stroke-width="3"
              stroke-opacity=".35"
            />
            <path
              d={`M${60 + i * 96} 0V400`}
              stroke="#b3844d"
              stroke-width="3"
              stroke-opacity=".3"
            />
          </>
        </g>
      ))
    }
    {
      cover.array.map((cell) => (
        <g>
          <>
            <rect
              x={cell.x - 35}
              y={cell.y - 35}
              width="70"
              height="70"
              rx="15"
              fill={cell.active ? '#c7dcca' : '#e3ead6'}
              stroke={cell.active ? '#6a9182' : '#b5c7a8'}
              stroke-width="3"
            />
            <text
              x={cell.x}
              y={cell.y + 12}
              text-anchor="middle"
              font-family="sans-serif"
              font-size="38"
              fill={cell.active ? '#426f67' : '#7f9579'}
            >
              {cell.sum}
            </text>
          </>
        </g>
      ))
    }
  </g>
  <g fill={color} fill-opacity=".45"
    ><circle cx="72" cy="193" r="4"></circle><circle cx="194" cy="192" r="4"></circle><circle
      cx="325"
      cy="187"
      r="4"></circle></g
  >
  <path d="M72 172V188M194 172V187M325 179V183" stroke="#8baa99" stroke-opacity=".4"></path>
</svg>
