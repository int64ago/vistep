---
const rings = Array.from({ length: 7 }, (_, i) => (i + 1) * 20);
---

<svg viewBox="0 0 360 270" fill="none" aria-hidden="true"
  ><defs
    ><clipPath id="ripple-cover-water"
      ><rect x="30" y="36" width="300" height="203" rx="12"></rect></clipPath
    ></defs
  >
  <rect
    x="28"
    y="34"
    width="304"
    height="207"
    rx="15"
    fill="#e1ebd9"
    stroke="#a6bca4"
    stroke-width="3"></rect>
  <g clip-path="url(#ripple-cover-water)"
    >{
      rings.map((r) => (
        <>
          <>
            <circle cx="116" cy="99" r={r} stroke="#96b3a3" stroke-width="2" />
            <circle cx="116" cy="180" r={r} stroke="#a3b98c" stroke-width="2" />
          </>
        </>
      ))
    }</g
  >
  <path d="M70 89V190M70 99H116M70 180H116" stroke="#9daa86" stroke-width="5" stroke-linecap="round"
  ></path><rect x="50" y="123" width="40" height="33" rx="7" fill="#c7d5b4" stroke="#96ab80"></rect>
  <circle cx="116" cy="99" r="5" fill="#b5a375"></circle><circle
    cx="116"
    cy="180"
    r="5"
    fill="#b5a375"></circle>
  <circle cx="260" cy="140" r="7" fill="none" stroke="#b39a65" stroke-width="2"></circle>
</svg>
