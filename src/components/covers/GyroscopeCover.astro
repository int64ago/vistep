      ><stop stop-color="#c8d3cc"></stop><stop offset="1" stop-color="#7e9f9d"
      ></stop></linearGradient
    ></defs
  ><ellipse cx="153" cy="188" rx="62" ry="14" fill="#dce4d5"></ellipse><path
    d="M153 185V89"
    stroke="#99ada1"
    stroke-width="9"
    stroke-linecap="round"></path><ellipse cx="153" cy="186" rx="33" ry="9" fill="#9bb49d"
  ></ellipse><g transform={`translate(153 89) rotate(${angle})`}
    ><path d="M0 0H115" stroke="#a4b6b1" stroke-width="7" stroke-linecap="round"></path><ellipse
      cx="82"
      cy="0"
      rx="25"
      ry="66"
      fill="url(#gyro-cover-metal)"
      stroke="#94adaa"
      stroke-width="3"></ellipse><ellipse cx="83" cy="0" rx="7" ry="17" fill="#bda66c"
    ></ellipse><path d="M0 0H42" stroke="#a4b6b1" stroke-width="7"></path><circle
      r="8"
      fill="#c7b17a"></circle></g
