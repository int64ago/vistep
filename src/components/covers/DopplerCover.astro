---
import { dopplerShot } from '../../models/doppler';
interface Props {
  color?: string;
}
const { color = '#52768b' } = Astro.props;
const { frame } = dopplerShot(2, 0.53);
const centerX = 194,
  centerY = 88,
  scale = 33;
const source = { x: centerX + frame.source.x * scale, y: centerY };
const observer = { x: centerX + frame.observer.x * scale, y: centerY };
const x = (time: number) =>
  42 + ((time - frame.rulerStart) / (frame.rulerEnd - frame.rulerStart)) * 330;
const inside = (time: number) => time >= frame.rulerStart && time <= frame.rulerEnd;
const waves = frame.wavefronts.filter((wave) => wave.radius * scale < 390);
const uid = `doppler-cover-${Math.abs(Math.round(frame.time * 1000))}`;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 230" fill="none" aria-hidden="true">
  <defs>
    <linearGradient
      id={`${uid}-paper`}
      x1="200"
      y1="0"
      x2="200"
      y2="230"
      gradientUnits="userSpaceOnUse"
      ><stop stop-color="#fcfcf6"></stop><stop offset="1" stop-color="#e9f0ec"
      ></stop></linearGradient
    >
    <clipPath id={`${uid}-field`}><rect width="400" height="155"></rect></clipPath>
  </defs>
  <path d="M0 0H400V230H0Z" fill={`url(#${uid}-paper)`}></path>
  <g clip-path={`url(#${uid}-field)`}>
    <path d="M0 88H400" stroke={color} stroke-opacity=".22" stroke-dasharray="2 6"></path>
    {
      waves.map((wave) => (
        <circle
          cx={centerX + wave.center.x * scale}
          cy={centerY}
          r={wave.radius * scale}
          stroke={wave.id === frame.previous.id ? '#a36d1e' : color}
          stroke-opacity={wave.id === frame.previous.id ? '.9' : '.32'}
          stroke-width={wave.id === frame.previous.id ? '2' : '1.3'}
        />
      ))
    }
    <path
      d={`M${source.x - 22} ${source.y - 25}h42l-6 -4m6 4l-6 4`}
      stroke="#ad533d"
      stroke-width="1.5"
      stroke-linecap="round"></path>
    <circle cx={source.x} cy={source.y} r="13" fill="#fff5eb" stroke="#ad533d" stroke-width="2"
    ></circle>
    <circle cx={source.x} cy={source.y} r="5" fill="#ad533d"></circle>
    <circle cx={observer.x} cy={observer.y} r="22" stroke="#176d68" stroke-opacity=".2"></circle>
    <path
      d={`M${observer.x} ${observer.y - 12}l12 12 -12 12 -12 -12Z`}
      fill="#f6fffb"
      stroke="#176d68"
      stroke-width="2"></path>
    <circle cx={observer.x} cy={observer.y} r="3" fill="#176d68"></circle>
  </g>
  <path d="M42 180H372M42 211H372" stroke="#a6b6b2"></path>
  <circle cx="23" cy="180" r="4" fill="#ad533d"></circle>
  <path d="M23 206l5 5-5 5-5-5Z" fill="#176d68"></path>
  <path d={`M${x(frame.time)} 166V222`} stroke={color} stroke-width="1.5"></path>
  {
    frame.events.map((event) => (
      <>
        {inside(event.emitted) && (
          <path
            d={`M${x(event.emitted)} 174v12`}
            stroke="#ad533d"
            stroke-width="2"
            stroke-opacity={event.emitted > frame.time ? '.35' : '.9'}
          />
        )}
        {inside(event.arrived) && (
          <path
            d={`M${x(event.arrived)} 204v14`}
            stroke="#176d68"
            stroke-width="2"
            stroke-opacity={event.arrived > frame.time ? '.35' : '.9'}
          />
        )}
      </>
    ))
  }
</svg>
