---
import { inductorDefaults, inductorOff } from '../../models/inductor-transient';
const p = inductorDefaults();
const points = Array.from(
  { length: 71 },
  (_, j) => `${170 + j * 2.3},${190 - (inductorOff(p, (j * 0.012) / 70).current / 0.3) * 90}`,
).join(' ');
