---
import {
  MOTOR as M,
  motorBarPoint,
  motorRingPoint,
  motorWindingPoint,
  motorStatorBore,
  type MotorPoint,
} from '../../models/induction-motor';
import { svgPolyline } from '../../lib/svg-cover';
interface Props {
  color?: string;
}
const { color = '#3a897b' } = Astro.props;
const project = ([x, y, z]: MotorPoint) => [201 + (x + 0.48 * z) * 47, 113 - y * 47 + z * 13];
const path = (points: MotorPoint[]) => svgPolyline(points.map(project));
const arc = (r: number, z: number, a: number, b: number) =>
  Array.from({ length: 61 }, (_, i) => {
    const angle = a + ((b - a) * i) / 60;
    return [r * Math.cos(angle), r * Math.sin(angle), z] as MotorPoint;
  });
// Only the front laminations show their slot edges; the rest are seen as a smooth bore wall.
const section = (z: number, samples = 180) =>
  path([
    ...arc(M.statorOuter, z, 0.62 * Math.PI, 2.08 * Math.PI),
    ...Array.from({ length: samples + 1 }, (_, i) => {
      const a = 2.08 * Math.PI - (1.46 * Math.PI * i) / samples,
        r = samples < 100 ? M.statorInner : motorStatorBore(a);
      return [r * Math.cos(a), r * Math.sin(a), z] as MotorPoint;
    }),
  ]) + 'Z';
const rings = (z: number) => path(Array.from({ length: 49 }, (_, i) => motorRingPoint(i / 48, z)));
---

<svg viewBox="0 0 400 230" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M78 195L274 217L333 183L135 167Z" fill={color} opacity=".1"></path>
  <path
    d={path([
      [0, 0, -2.7],
      [0, 0, 2.7],
    ])}
    stroke="#788b8d"
    stroke-width="15"></path>
  {
    Array.from({ length: 21 }, (_, i) => (
      <path
        d={section(-0.98 + i * 0.098, i >= 18 ? 180 : 36)}
        fill={i % 3 ? '#758a8c' : '#526970'}
        stroke="#536d73"
        stroke-width=".6"
      />
    ))
  }
  <path d={path(arc(0.88, -1, 0, Math.PI * 2)) + 'Z'} fill="#617980"></path>
  {
    Array.from({ length: M.bars }, (_, i) => (
      <path
        d={path([motorBarPoint(i, -M.ringZ, 0.33), motorBarPoint(i, M.ringZ, 0.33)])}
        stroke={i < 12 ? '#c28e5e' : '#a97c54'}
        stroke-width="3.4"
      />
    ))
  }
  {[-1, 1].map((sign) => <path d={rings(sign * M.ringZ)} stroke="#dbb488" stroke-width="6.4" />)}
  {
    [0, 1, 2].map((phase) => (
      <path
        d={path(Array.from({ length: 241 }, (_, i) => motorWindingPoint(phase, i / 240)))}
        stroke={['#cb895f', '#69a397', '#9e95ba'][phase]}
        stroke-width="1.65"
      />
    ))
  }
  <path d={section(0.99)} fill="#879b98" fill-opacity=".65" stroke="#66877f" stroke-width="1"
  ></path>
  <path
    d={path([
      [0, 0, 1.4],
      [0.65, 0.5, 1.4],
    ])}
    stroke={color}
    stroke-width="3"
    stroke-linecap="round"></path>
  <path
    d={path([
      [0.41, 0.49, 1.4],
      [0.65, 0.5, 1.4],
      [0.56, 0.26, 1.4],
    ])}
    stroke={color}
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    d={path([
      [0, 0, 2.25],
      [0.22, 0.07, 2.25],
    ])}
    stroke="#d4a363"
    stroke-width="6"></path>
  <path
    d="M314 100A32 32 0 0 1 334 139M326 131L334 139L340 129"
    stroke={color}
    stroke-width="2"
    opacity=".7"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
