---
import { opAmpDefaults, opAmpStep } from '../../models/op-amp-feedback';
const p = opAmpDefaults();
const points = Array.from(
  { length: 81 },
  (_, j) => `${208 + j * 1.65},${201 - (opAmpStep(p, 0.8, (j / 80) * 25e-6).output / 10) * 72}`,
).join(' ');
