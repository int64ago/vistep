---
import { tcpSimulate, tcpSeq } from '../../models/tcp-reliability';
const { color = '#7a9fa6' } = Astro.props,
  run = tcpSimulate(),
  y = (t: number) => 36 + (t / run.end) * 155;
---

<svg viewBox="0 0 400 230" width="400" height="230" fill="none" aria-hidden="true">
  <path d="M55 25V205M345 25V205" stroke={color} opacity=".5"></path>
  {
    run.transmissions.map((tx) => (
      <path
        d={`M55 ${y(tx.sent)}L${tx.lost ? 195 : 345} ${y(tx.lost ? tx.sent + 0.24 : tx.arrives)}`}
        stroke={tx.retransmit ? '#bd8e53' : tx.lost ? '#bc8270' : color}
        stroke-width={tx.retransmit ? 2.5 : 1.4}
        stroke-dasharray={tx.lost ? '4 3' : undefined}
      />
    ))
  }
  {
    run.acks.map((a) => (
      <path
        d={`M345 ${y(a.at)}L55 ${y(a.arrives)}`}
        stroke="#9cacc0"
        stroke-width=".8"
        stroke-dasharray="3 4"
      />
    ))
  }
  <text x="65" y="25" font-family="monospace" font-size="16" fill={color}>SEQ {tcpSeq(1)}</text>
  <text x="185" y="217" font-family="monospace" font-size="16" fill="#a8804d"
    >RETRY: SAME BYTES</text
  >
</svg>
