---
import { oxygenSourceAtoms } from '../../models/chem-chlorine-discovery';
const atoms = oxygenSourceAtoms(0.64, 500);
const source = oxygenSourceAtoms(0, 500).find((a) => a.element === 'O')!;
const oxygen = atoms.find((a) => a.element === 'O')!;
const colours = { O: '#c68959', H: '#f5ecd9', Cl: '#aab77d', Pb: '#9da7a3' };
---

<svg viewBox="0 0 640 400" aria-hidden="true">
  <defs
    ><radialGradient id="ccd-cover-paper"
      ><stop stop-color="#fbf7e8"></stop><stop offset="1" stop-color="#e9eddb"
      ></stop></radialGradient
    ></defs
  >
  <rect width="640" height="400" fill="url(#ccd-cover-paper)"></rect>
  <path d="M53 49H584M53 344H584" stroke="#a9b697" opacity=".45"></path>
  <g transform="translate(70,65) scale(1,1.1)">
    <path
      d={`M${source.x} ${source.y} Q255 4 ${oxygen.x} ${oxygen.y}`}
      fill="none"
      stroke="#c68959"
      stroke-width="2.5"
      stroke-dasharray="5 7"></path>
    <circle cx={source.x} cy={source.y} r="23" fill="none" stroke="#c68959" opacity=".2"></circle>
    {
      atoms.map((a) => (
        <g transform={`translate(${a.x},${a.y})`}>
          {a.element === 'O' && <circle r="29" fill="none" stroke="#c68959" opacity=".4" />}
          <circle r={a.element === 'O' ? 23 : 19} fill={colours[a.element]} stroke="#79846b44" />
          <text y="6" text-anchor="middle" font-size="19" font-family="sans-serif" fill="#435344">
            {a.element}
          </text>
        </g>
      ))
    }
  </g>
  <text x="320" y="308" text-anchor="middle" font-family="sans-serif" font-size="24" fill="#66765d"
    >PbO + 2HCl → PbCl₂ + H₂O</text
  >
</svg>
