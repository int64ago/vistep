---
import { ATOMIC_LINES, transitionEnergy, wavelengthColour } from '../../models/chem-flame-spectra';
const line = transitionEnergy('Na-D2');
const upperY = 168 - (line.gapEv / 4) * 155;
---

<svg viewBox="0 0 400 230" fill="none" aria-hidden="true">
  <rect width="400" height="230" rx="18" fill="#21493d"></rect>
  <path d={`M47 ${upperY}H157M47 168H157`} stroke="#bfcfb5" stroke-width="3"></path>
  <path d={`M105 ${upperY + 12}V154m-7-8 7 8 7-8`} stroke="#e7ca8c" stroke-width="2.5"></path>
  <circle cx="105" cy="168" r="7" fill="#edd29b"></circle>
  <text x="51" y="55" fill="#d0ddc3" font-size="25">Na</text>
  <text x="102" y="206" text-anchor="middle" fill="#dcc799" font-size="24"
    >{line.gapEv.toFixed(2)} eV</text
  >
  <path d="M177 88H325" stroke="#8ca790" stroke-width="2" stroke-dasharray="3 8"></path>
  <path d="M225 88q4-10 8 0t8 0t8 0t8 0" stroke={wavelengthColour(line.airNm)} stroke-width="3"
  ></path>
  <path d="M327 87V151" stroke="#7f9a86" stroke-width="2" stroke-dasharray="3 6"></path>
  <rect x="223" y="154" width="149" height="27" rx="6" fill="#102b24"></rect>
  {
    ATOMIC_LINES.Na.map((x) => (
      <path
        d={`M${223 + ((x.nm - 500) / 150) * 149} 157v21`}
        stroke={wavelengthColour(x.nm)}
        stroke-width="2"
        opacity={x.weight}
      />
    ))
  }
  <text x="276" y="211" fill="#c9d8bd" text-anchor="middle" font-size="24">589 nm</text>
</svg>
