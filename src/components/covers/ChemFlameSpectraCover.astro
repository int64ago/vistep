---
import { flameLines, wavelengthColour } from '../../models/chem-flame-spectra';
const lines = flameLines('K', 0.5, true);
---

<svg viewBox="0 0 400 230" fill="none" aria-hidden="true"
  ><rect width="400" height="230" rx="18" fill="#21493d"></rect><path
    d="M65 180Q44 147 86 55Q79 115 104 131Q127 162 96 182Z"
    fill="#baa2d5"
    opacity=".8"></path><path d="M77 180Q69 157 87 124Q83 156 96 181Z" fill="#a6c6db"></path><rect
    x="68"
    y="184"
    width="33"
    height="27"
    rx="5"
    fill="#88a28a"></rect><path
    d="M117 113Q91 106 86 121Q83 131 96 130Q108 128 106 117M115 113L178 75"
    stroke="#d0d8b7"
    stroke-width="3"></path><rect
    x="187"
    y="57"
    width="37"
    height="94"
    rx="5"
    fill="#8196ce"
    fill-opacity=".5"
    stroke="#9eafd0"></rect><path d="M107 111H185M226 111H260" stroke="#bda4d7"></path><rect
    x="253"
    y="171"
    width="125"
    height="34"
    rx="4"
    fill="#0e2b24"></rect>{
    lines.map((x) => (
      <path
        d={`M${253 + ((x.nm - 390) / 390) * 125} 173v30`}
        stroke={wavelengthColour(x.nm)}
        stroke-width="2"
        opacity={Math.min(1, x.observed)}
      />
    ))
  }</svg
>
