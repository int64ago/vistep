---
import { isotopeRadius } from '../../models/charged-particle-lab';
const paths = [20, 22].map((m) => {
  const r = isotopeRadius(m).radius;
  return Array.from({ length: 100 }, (_, j) => {
    const a = (Math.PI * j) / 99;
    return `${j ? 'L' : 'M'}${113 + r * Math.sin(a) * 810} ${57 + r * (1 - Math.cos(a)) * 810}`;
  }).join(' ');
});
---

<svg viewBox="0 0 400 230" aria-hidden="true">
  <rect x="76" y="20" width="260" height="190" rx="22" fill="#e0eadb" stroke="#c0cfb6"></rect>
  <path d="M35 57H113" stroke="#90aa8e" stroke-width="3"></path><rect
    x="26"
    y="42"
    width="37"
    height="31"
    rx="6"
    fill="#c3d0b7"
    stroke="#8ea682"></rect>
  <path d="M73 38v39M88 38v39" stroke="#b89b60" stroke-width="3"></path>
  {
    Array.from({ length: 12 }, (_, i) => (
      <g opacity=".35">
        <>
          <circle
            cx={152 + (i % 4) * 47}
            cy={52 + Math.floor(i / 4) * 62}
            r="4"
            stroke="#78977a"
            fill="none"
          />
          <circle cx={152 + (i % 4) * 47} cy={52 + Math.floor(i / 4) * 62} r="1.3" fill="#78977a" />
        </>
      </g>
    ))
  }
  <rect x="106" y="145" width="10" height="58" rx="3" fill="#8fa38b"></rect>
  {
    paths.map((d, i) => (
      <path d={d} stroke={i ? '#b58f53' : '#628d70'} stroke-width="3" fill="none" />
    ))
  }
  <path d="M113 57h31l-7-4m7 4-7 4" stroke="#ad925b" stroke-width="2" fill="none"></path>
</svg>
