---
import { excavatorDrawing } from '../../models/excavator-drawing';
// Catalog artwork: the machine mid-lift with the near boom cylinder sectioned,
// placed from the same pose model as the film. The 400×230 card frame maps
// metres to pixels with one uniform scale so the side view keeps its proportions.
const { primitives } = excavatorDrawing(
  { boom: 0.66, stick: -1.62, curl: 1.45 },
  { section: true, payload: 1200 },
);
---

<g transform="translate(150 212) scale(29 -29)" stroke-linecap="round" stroke-linejoin="round">
  <path d="M-3.2 0H12.6" stroke="#cfd2c7" stroke-width="0.05"></path>
  {
    primitives.map((s) =>
      s.kind === 'circle' ? (
        <circle
          cx={s.c.x}
          cy={s.c.y}
          r={s.r}
          fill={s.fill}
          stroke={s.stroke}
          stroke-width={s.width}
        />
      ) : (
        <path
          d={s.d}
          fill={s.fill ?? 'none'}
          stroke={s.stroke}
          stroke-width={s.width}
          opacity={s.opacity}
        />
      ),
    )
  }
</g>
