---
import { logisticPopulation, densityRates } from '../../models/bio-population-growth';
const rates = densityRates(375),
  path = Array.from({ length: 81 }, (_, i) => {
    const t = (i / 80) * 7;
    return `${i ? 'L' : 'M'}${28 + (t / 7) * 344} ${173 - (logisticPopulation(t).value / 400) * 123}`;
  }).join(' ');
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs
    ><linearGradient id="bpg19cover" x2="0" y2="1"
      ><stop stop-color="#f2f5e9"></stop><stop offset="1" stop-color="#e5ead7"
      ></stop></linearGradient
    ></defs
  >
  <rect width="400" height="230" fill="url(#bpg19cover)"></rect>
  <path d="M28 36v137h344" fill="none" stroke="#c2ccb3"></path>
  <path d={path} fill="none" stroke="#819d6d" stroke-width="4" stroke-linecap="round"></path>
  <path d="M220 48h152" stroke="#b6c2a7" stroke-dasharray="5 5"></path>
  <g transform="translate(276 102)">
    <ellipse cx="-37" rx="10" ry="20" fill="#bbcea5" stroke="#7b9867"></ellipse>
    <ellipse cx="-8" rx="10" ry="20" fill="#bbcea5" stroke="#7b9867"></ellipse>
    <ellipse cx="40" rx="10" ry="20" fill="#c5b5a1" stroke="#aa947b" opacity=".45"></ellipse>
    <path d="M-36-4v8m-4-4h8M36 0h8" stroke="#647b54" stroke-width="2"></path>
  </g>
  <path
    d={`M105 199h${rates.birthRate * 55}`}
    stroke="#7b9867"
    stroke-width="9"
    stroke-linecap="round"></path>
  <path
    d={`M225 199h${rates.deathRate * 55}`}
    stroke="#b4967c"
    stroke-width="9"
    stroke-linecap="round"></path>
  <path d="M195 195h10m-10 8h10" stroke="#647253" stroke-width="2"></path>
</svg>
