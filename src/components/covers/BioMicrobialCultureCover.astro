---
import { pureCulture, plateGeometry } from '../../models/bio-microbial-culture';
const w = 300,
  g = plateGeometry(w),
  colonies = pureCulture(1, w);
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#f1eedc"></rect><g transform="translate(20 -37) scale(1.1)"
    ><circle cx={g.cx} cy={g.cy} r={g.r + 4} fill="#f8f4e5" stroke="#b8c2ac" stroke-width="2"
    ></circle><circle cx={g.cx} cy={g.cy} r={g.r} fill="#e3d9ac"></circle>{
      colonies.map((a) => <circle cx={a.x} cy={a.y} r={a.r} fill="#b1a378" opacity=".8" />)
    }<path
      d={`M${g.cx - g.r * 0.8} ${g.cy - g.r * 0.45}A${g.r} ${g.r} 0 0 1 ${g.cx + g.r * 0.35} ${g.cy - g.r * 0.88}`}
      stroke="#fcf9e8"
      stroke-width="3"
      fill="none"></path></g
  >
  <path d="M330 53V178" fill="none" stroke="#c2cdb0" stroke-width="5" stroke-linecap="round"></path>
  <ellipse cx="330" cy="54" rx="29" ry="18" fill="#ddcca2" stroke="#b6aa84"></ellipse>
  <ellipse cx="330" cy="115" rx="29" ry="18" fill="#d7dfbd" stroke="#b0bd99"></ellipse>
  <ellipse cx="330" cy="180" rx="37" ry="24" fill="#bdcda3" stroke="#8fa479" stroke-width="2"
  ></ellipse>
  <circle cx="320" cy="174" r="7" fill="#cfad73"></circle>
  <circle cx="340" cy="184" r="7" fill="#ad9bbd"></circle>
  <path d="M325 84l5 7 5-7m-10 60 5 7 5-7" fill="none" stroke="#96a382" stroke-width="2"></path>
</svg>
