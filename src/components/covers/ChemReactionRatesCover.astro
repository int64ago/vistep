---
import { thermalTrials, peroxide } from '../../models/chem-reaction-rates';
const cold = thermalTrials(20),
  hot = thermalTrials(50);
const xx = (e: number) => 25 + (e - 27) * 10;
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#e2e9d8"></rect>
  <path d="M105 29V202" stroke="#ba8966" stroke-width="2" stroke-dasharray="5 5"></path>
  {
    hot.map((a, i) => (
      <g>
        <>
          <path
            d={`M${xx(cold[i].energy)} ${43 + i * 20}H${xx(a.energy)}`}
            stroke={a.eligible ? '#779b85' : '#afbba7'}
            stroke-width="5"
            stroke-linecap="round"
          />
          <circle
            cx={xx(a.energy)}
            cy={43 + i * 20}
            r="6"
            fill={a.eligible ? '#648c77' : '#b8c3ad'}
          />
        </>
      </g>
    ))
  }
  {
    [20, 50].map((t, i) => {
      const x = 255 + i * 83,
        n = peroxide(8, t, 'Fe');
      return (
        <g>
          <path
            d={`M${x - 15} 106V174Q${x - 15} 190 ${x} 190Q${x + 15} 190 ${x + 15} 174V106Z`}
            fill="#ddd3a2"
          />
          {Array.from({ length: Math.min(10, Math.ceil(n.rate * 120000)) }, (_, j) => (
            <circle
              cx={x - 9 + ((j * 7) % 19)}
              cy={174 - j * 8}
              r="3"
              fill="#f7f9ed"
              stroke="#a8bdac"
            />
          ))}
        </g>
      );
    })
  }
</svg>
