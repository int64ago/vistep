---
import { resultantExperiment } from '../../models/force-resultant-lab';
const s = resultantExperiment();
const p = (v: { x: number; y: number }) => ({ x: 200 + v.x * 40, y: 143 - v.y * 40 });
const a = p(s.left),
  b = p(s.right),
  r = p(s.sum);
---

<svg viewBox="0 0 400 230" aria-hidden="true" fill="none">
  <rect x="68" y="18" width="263" height="200" rx="12" fill="#f1eddd"></rect>
  <path d="M196 204Q190 175 196 148M204 204Q210 175 204 148" stroke="#b89870" stroke-width="3"
  ></path>
  <circle cx="200" cy="205" r="5" fill="#97a584"></circle>
  <path d={`M200 143L${a.x} ${a.y}`} stroke="#b28d60" stroke-width="2.5"></path><path
    d={`M200 143L${b.x} ${b.y}`}
    stroke="#8b9f76"
    stroke-width="2.5"></path>
  <path d={`M${a.x} ${a.y}L${r.x} ${r.y}L${b.x} ${b.y}`} stroke="#adb69a" stroke-dasharray="4 4"
  ></path>
  <path d={`M200 143L${r.x} ${r.y}`} stroke="#719485" stroke-width="3"></path>
  <circle cx="200" cy="143" r="7" fill="#f7f2e6" stroke="#9caa89" stroke-width="2"></circle>
  <circle cx={a.x} cy={a.y} r="3" fill="#b28d60"></circle><circle
    cx={b.x}
    cy={b.y}
    r="3"
    fill="#8b9f76"></circle>
  <path
    d={`M${r.x - 5} ${r.y + 8}L${r.x} ${r.y}L${r.x + 5} ${r.y + 8}`}
    stroke="#719485"
    stroke-width="2"></path>
</svg>
