---
import { mobile5gCover } from '../../models/mobile-5g-cover';
const cover = mobile5gCover();
---

<svg viewBox="0 0 400 230" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill={cover.background}></rect>
  {
    cover.shapes.map(({ d, fill, stroke, width, opacity }) => (
      <path
        d={d}
        fill={fill ?? 'none'}
        stroke={stroke}
        stroke-width={width}
        opacity={opacity}
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ))
  }
</svg>
