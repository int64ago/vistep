---
import { silverTransferGeometry } from '../../models/chem-precipitation-paths';
const geometry = silverTransferGeometry(400, 1, 0, 'iodide', 0.22);
const trace = Array.from({ length: 41 }, (_, i) => {
  const p = silverTransferGeometry(400, 1, 0, 'iodide', (i * 0.4) / 40).tokens[0];
  return `${i ? 'L' : 'M'}${p.x.toFixed(2)} ${p.y.toFixed(2)}`;
}).join(' ');
---

<svg viewBox="0 0 400 280" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="ppx-cover-water" x2="0" y2="1">
      <stop stop-color="#e7ecdc" stop-opacity=".2"></stop>
      <stop offset="1" stop-color="#b5cdb9" stop-opacity=".45"></stop>
    </linearGradient>
  </defs>
  <path
    d="M23 35V239Q23 262 46 262H354Q377 262 377 239V35"
    fill="url(#ppx-cover-water)"
    stroke="#a9bda8"
    stroke-width="2"></path>
  <path d="M26 221Q75 211 126 223V259H46Q26 259 26 239Z" fill="#e7e2c9"></path>
  <path d="M149 227Q200 209 251 227V259H149Z" fill="#d4be69" opacity=".65"></path>
  <path d={trace} stroke="#acb99d" stroke-width="2" stroke-dasharray="4 6"></path>
  {
    geometry.tokens.map((t) => (
      <g transform={`translate(${t.x} ${t.y})`}>
        {t.tracked && <circle r="18" stroke="#b58e40" stroke-width="2" />}
        <circle
          r="12"
          fill={t.phase === 'water' ? '#9fbead' : t.phase === 1 ? '#d8c471' : '#e8e3cb'}
          stroke="#fff9e7"
          stroke-width="2"
        />
      </g>
    ))
  }
  <circle cx="266" cy="73" r="15" fill="#d8c471" stroke="#f8f0cd" stroke-width="2"></circle>
  <path d="M254 83Q238 107 216 119" stroke="#b8ab6b" stroke-width="2"></path>
  <path d="M222 109L215 120L228 119" stroke="#b8ab6b" stroke-width="2"></path>
</svg>
