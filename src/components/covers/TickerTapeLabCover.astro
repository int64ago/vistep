---
import { tapeDots, tapeMotion } from '../../models/ticker-tape-lab';
const dots = tapeDots('cart', 1, 20),
  max = tapeMotion('cart', 1).x;
---

<svg viewBox="0 0 400 230" aria-hidden="true"
  ><path d="M28 122H373" stroke="#acbba4" stroke-width="6" stroke-linecap="round"></path><rect
    x="56"
    y="95"
    width="239"
    height="12"
    fill="#e9e2cd"></rect><rect x="42" y="59" width="60" height="42" rx="10" fill="#afc0aa"
  ></rect><rect x="53" y="71" width="35" height="16" rx="5" fill="#b79a73"></rect>{
    [0, 1, 2, 3, 4].map((i) => (
      <path d={`M${57 + i * 6} 73V85`} stroke="#8e7757" stroke-width="2" />
    ))
  }<path d="M73 68V103" stroke="#6e846c" stroke-width="2"></path><rect
    x="284"
    y="89"
    width="57"
    height="24"
    rx="7"
    fill="#91aa82"></rect><circle cx="297" cy="120" r="8" fill="#708d70"></circle><circle
    cx="328"
    cy="120"
    r="8"
    fill="#708d70"></circle><rect x="24" y="164" width="352" height="28" rx="3" fill="#eee6ce"
  ></rect>{
    dots.map((d) => (
      <circle cx={39 + (d.x / max) * 320} cy="178" r={d.index % 4 === 0 ? 3 : 1.5} fill="#658567" />
    ))
  }<path d="M93 199H280M93 194V204M280 194V204" stroke="#b3935c" stroke-width="1.5"></path></svg
>
