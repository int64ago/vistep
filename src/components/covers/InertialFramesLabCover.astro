---
import { paperBall, inertiaGeometry } from '../../models/inertial-frames-lab';
const state = paperBall(0.22);
const frames = ['lab', 'paper'] as const;
---

<svg viewBox="0 0 400 230" aria-hidden="true" fill="none">
  {
    frames.map((frame, i) => {
      const g = inertiaGeometry(state, frame, 360);
      return (
        <g transform={`translate(20 ${i * 96 + 16})`}>
          <rect x="0" y={g.surfaceY} width="360" height="10" rx="3" fill="#cfbc9e" />
          <rect x={g.paperX} y={g.surfaceY} width={g.paperWidth} height="2.5" fill="#faf5e8" />
          <circle cx={g.ballX} cy={g.ballY} r={g.ballRadius} fill="#8fa69a" />
          <path
            d={`M${g.origin} 86H${g.ballX}`}
            stroke={i ? '#ac9066' : '#8da17c'}
            stroke-width="2"
          />
        </g>
      );
    })
  }
</svg>
