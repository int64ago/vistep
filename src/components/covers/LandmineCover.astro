---
import { landmineCover } from '../../models/landmine-art';
const art = landmineCover();
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#f1ede1"></rect>
  {
    art.paths.map(({ d, fill, stroke, width, opacity }) => (
      <path
        d={d}
        fill={fill}
        stroke={stroke}
        stroke-width={width}
        opacity={opacity}
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ))
  }
  <path
    d="M310 37L322 59H298Z"
    fill="none"
    stroke="#a26143"
    stroke-width="1.7"
    stroke-linejoin="round"></path>
  <path d="M310 44V50M310 54V55" stroke="#a26143" stroke-width="2" stroke-linecap="round"></path>
</svg>
