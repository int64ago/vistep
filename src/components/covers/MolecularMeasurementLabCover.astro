---
import { oilBoundary } from '../../models/molecular-measurement-lab';
const outline =
  oilBoundary(200)
    .map((p, i) => `${i ? 'L' : 'M'}${180 + p.x * 10} ${143 + p.y * 10}`)
    .join(' ') + 'Z';
---

<svg viewBox="0 0 360 270" fill="none" aria-hidden="true">
  <rect
    x="30"
    y="35"
    width="300"
    height="205"
    rx="22"
    fill="#d9e7d5"
    stroke="#aec4a3"
    stroke-width="3"></rect>
  <path d={outline} fill="#ead9a7" stroke="#b79f68"></path>
  {
    Array.from({ length: 29 }, (_, i) => (
      <path d={`M${40 + i * 10} 40V235`} stroke="#b1c29e" stroke-width=".7" />
    ))
  }
  {
    Array.from({ length: 20 }, (_, i) => (
      <path d={`M35 ${45 + i * 10}H325`} stroke="#b1c29e" stroke-width=".7" />
    ))
  }
</svg>
