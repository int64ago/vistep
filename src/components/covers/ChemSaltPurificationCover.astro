  ></path><ellipse cx="205" cy="120" rx="62" ry="10" fill="none" stroke="#a7b6ab" stroke-width="4"
  ></ellipse><path
    d="M133 105L195 199V278H211V199L276 105Z"
    stroke="#a1b4b3"
    stroke-width="2.5"
    fill="#e5efeb44"></path><path
    d="M145 112L203 194L263 112"
    fill="#f4f1df"
    stroke="#cec9b5"
