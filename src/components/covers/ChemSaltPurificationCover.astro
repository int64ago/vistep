    Array.from({ length: 33 }, (_, i) => (
      <circle
        cx={169 + ((i * 17) % 74)}
        cy={130 + ((i * 11) % 30)}
        r="4"
        fill={i % 8 ? '#fcfbed' : '#b9ad90'}
        opacity={retained / 3.3}
