---
import { bjtDefaults, bjtPoint, bjtBias } from '../../models/bjt-amplifier';
const p = bjtDefaults();
const bias = bjtBias(p);
const output = Array.from(
  { length: 101 },
  (_, j) =>
    `${190 + j * 1.5},${190 - (bjtPoint(p, bias + 0.008 * Math.sin((j / 100) * 4 * Math.PI)).collectorVoltage / 5) * 75}`,
).join(' ');
const input = Array.from(
  { length: 101 },
  (_, j) => `${190 + j * 1.5},${70 - 18 * Math.sin((j / 100) * 4 * Math.PI)}`,
).join(' ');
---

