---
import { chromatography, pigmentTransmission } from '../../models/bio-leaf-pigments';
const state = chromatography(1);
const curve = Array.from(
  { length: 61 },
  (_, i) =>
    `${i ? 'L' : 'M'}${177 + i * 3} ${174 - pigmentTransmission('a', 400 + i * 5).absorbed * 111}`,
).join(' ');
---

<svg viewBox="0 0 400 230" aria-hidden="true"
  ><rect width="400" height="230" rx="24" fill="#efeddb"></rect><rect
    x="61"
    y="14"
    width="59"
    height="201"
    rx="3"
    fill="#f6f1dc"></rect>{
    state.bands.map((b) => (
      <rect x="66" y={199 - b.distance} width="49" height="6" rx="2" fill={b.color} />
    ))
  }<path d="M56 199H126M66 29H115" stroke="#9b9f81" stroke-dasharray="3 4"></path><path
    d="M177 45V176H357"
    fill="none"
    stroke="#bdc5a7"></path><path d={curve} fill="none" stroke="#4b8c7a" stroke-width="3"
  ></path></svg
>
