---
import { chromatography, pigmentTransmission } from '../../models/bio-leaf-pigments';
const state = chromatography(1);
const curve = Array.from(
  { length: 61 },
  (_, i) =>
    `${i ? 'L' : 'M'}${183 + i * 3} ${178 - pigmentTransmission('a', 400 + i * 5).absorbed * 116}`,
).join(' ');
---

<svg viewBox="0 0 400 230" aria-hidden="true">
  <defs>
    {
      state.bands.map((b) => (
        <linearGradient
          id={`blp11-cover-${b.id}`}
          gradientUnits="userSpaceOnUse"
          x1="0"
          x2="0"
          y1="218"
          y2="-2"
        >
          {Array.from({ length: 56 }, (_, i) => {
            const mass = b.distribution.bins.reduce(
              (sum, v) => sum + v.mass * Math.max(0, 1 - Math.abs(v.cell - (i - 5))),
              0,
            );
            return (
              <stop offset={i / 55} stop-color={b.color} stop-opacity={Math.min(1, mass * 8)} />
            );
          })}
        </linearGradient>
      ))
    }
  </defs>
  <rect width="400" height="230" rx="24" fill="#efeddb"></rect>
  <rect x="52" y="16" width="73" height="198" rx="6" fill="#f8f2df"></rect>
  {
    state.bands.map((b) => (
      <rect x="57" y="16" width="63" height="198" fill={`url(#blp11-cover-${b.id})`} />
    ))
  }
  <path d="M46 198H132M57 30H120" stroke="#8d9c7e" stroke-dasharray="3 4" fill="none"></path>
  <path d="M183 51V180H363" fill="none" stroke="#adb99d"></path>
  <path d={curve} fill="none" stroke="#4b8c7a" stroke-width="3"></path>
  <path
    d="M150 96v-21m-5 6 5-6 5 6M141 145v21m-5-6 5 6 5-6"
    fill="none"
    stroke="#94a47e"
    stroke-width="2"></path>
  <circle cx="151" cy="123" r="6" fill="#4b8c7a"></circle><path
    d="M142 107l6 6-6 6-6-6Z"
    fill="#96a44d"></path>
</svg>
