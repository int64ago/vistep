---
import { ecCase } from '../../models/error-correction';
interface Props {
  color?: string;
}
const { color = '#7b9078' } = Astro.props;
const sample = ecCase(11, 'hamming', [6]);
const positions = [
  [55, 69],
  [175, 69],
  [115, 51],
  [115, 191],
  [79, 139],
  [151, 139],
  [115, 105],
];
const loops = [
  [83, 89, color],
  [147, 89, '#b1975a'],
  [115, 143, '#a5869d'],
] as const;
---

<svg viewBox="0 0 400 230" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#f4f2e9"></rect>
  {
    loops.map(([cx, cy, ink]) => (
      <circle cx={cx} cy={cy} r="63" stroke={ink} stroke-width="2" fill={ink} fill-opacity=".055" />
    ))
  }
  {
    positions.map(([x, y], i) => (
      <g>
        <circle
          cx={x}
          cy={y}
          r="13"
          fill="#fcfaf3"
          stroke={i === 5 ? '#a95345' : '#c7caba'}
          stroke-width={i === 5 ? 2 : 1}
        />
        <text
          x={x}
          y={y + 5}
          text-anchor="middle"
          font-size="17"
          font-family="monospace"
          fill="#34423b"
        >
          {sample.received[i]}
        </text>
        <text
          x={x - 15}
          y={y - 13}
          text-anchor="middle"
          font-size="11"
          font-family="sans-serif"
          fill="#778071"
        >
          {i + 1}
        </text>
      </g>
    ))
  }
  <path
    d="M170 146 C219 150 211 101 244 105"
    stroke="#a95345"
    stroke-width="1.3"
    stroke-dasharray="3 4"></path>
  <text x="250" y="66" font-size="12" letter-spacing="2" font-family="sans-serif" fill="#728170"
    >HAMMING</text
  >
  <text x="246" y="111" font-size="34" font-family="monospace" fill="#3d5747"
    >{[...sample.decoded.checks].reverse().join('')}<tspan font-size="16">₂</tspan></text
  >
  <text x="250" y="145" font-size="24" font-family="monospace" fill="#805249"
    >= {sample.decoded.syndrome}</text
  >
  <path d="M248 167h111" stroke="#c6cebf"></path>
  {
    sample.data.map((bit, i) => (
      <text x={258 + i * 25} y="194" font-size="19" font-family="monospace" fill={color}>
        {bit}
      </text>
    ))
  }
</svg>
