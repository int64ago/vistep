---
import { floatState } from '../../models/floating-oscillator';
const s = floatState(0.4, 0.04, 0),
  top = 86 - 420 * (s.length - s.immersion + s.x),
  bottom = top + 420 * s.length;
---

<svg viewBox="0 0 300 220" aria-hidden="true"
  ><path d="M60 48v140q0 13 13 13h154q13 0 13-13V48" fill="none" stroke="#b5ccc1" stroke-width="3"
  ></path><path d="M62 86h176v101q0 12-12 12H74q-12 0-12-12Z" fill="#b5d1c5" opacity=".5"
  ></path><ellipse cx="150" cy="86" rx="88" ry="9" fill="#cde0d4"></ellipse><path
    d={`M150 ${top}V${bottom}`}
    stroke="#c1a071"
    stroke-width="9"
    stroke-linecap="round"></path>{
    [0, 1, 2].map((i) => (
      <path
        d={`M144 ${bottom - 5 - i * 4}q6-4 12 0`}
        stroke="#87938b"
        fill="none"
        stroke-width="2"
      />
    ))
  }<path d="M95 86h110" stroke="#8db2a3" stroke-width="2"></path><path
    d="M197 113v-30l-4 7m4-7 4 7"
    stroke="#90ab92"
    stroke-width="3"
    fill="none"></path></svg
>
