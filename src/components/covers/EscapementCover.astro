---
import {
  ESC,
  ESC_PALLETS,
  escWorld,
  escapementPose,
  escapementTooth,
} from '../../models/escapement';
interface Props {
  color?: string;
}
const { color = '#9a7950' } = Astro.props;
const pose = escapementPose(0.248);
const point = ([x, y]: number[]) => `${158 + x * 44},${130 - y * 44}`;
const path = (pts: number[][]) => pts.map((p, i) => `${i ? 'L' : 'M'}${point(p)}`).join(' ') + 'Z';
const pivot = [158, 130 - ESC.height * 44],
  bob = [158 + pose.bob[0] * 44, 130 - pose.bob[1] * 44];
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
  <defs
    ><linearGradient id="esc-brass" x1=".15" y1="0" x2=".9" y2="1"
      ><stop stop-color="#e0cba0"></stop><stop offset="1" stop-color={color}></stop></linearGradient
    ></defs
  >
  <path
    d="M47 213V27H269V213"
    stroke="#83918b"
    stroke-width="9"
    stroke-linejoin="round"
    opacity=".35"></path>
  <path d="M48 213H270" stroke="#665f50" stroke-width="10" stroke-linecap="round"></path>
  <circle cx="158" cy="130" r={ESC.rootRadius * 44} fill="url(#esc-brass)"></circle>
  <circle cx="158" cy="130" r="39" fill="#f3f1e8"></circle>
  {
    Array.from({ length: 5 }, (_, i) => {
      const a = (i * Math.PI * 2) / 5 - pose.wheel;
      return (
        <path
          d={`M158 130L${158 + 42 * Math.cos(a)} ${130 - 42 * Math.sin(a)}`}
          stroke={color}
          stroke-width="6"
        />
      );
    })
  }
  {
    Array.from({ length: 30 }, (_, i) => (
      <path
        d={path(escapementTooth(i, pose.wheel))}
        fill="url(#esc-brass)"
        stroke="#9e855b"
        stroke-width=".4"
      />
    ))
  }
  {
    ESC_PALLETS.map((p) => {
      const tip = escWorld(p.attachment, pose.anchor);
      return (
        <>
          <>
            <path
              d={`M${pivot.join(' ')}L${point(tip)}`}
              stroke="#647e83"
              stroke-width="7"
              stroke-linecap="round"
            />
            <path
              d={path(p.outline.map((v) => escWorld(v, pose.anchor)))}
              fill="#a86f61"
              stroke="#78574e"
              stroke-width=".5"
            />
          </>
        </>
      );
    })
  }
  <path d={`M${pivot.join(' ')}L${bob.join(' ')}`} stroke="#526f74" stroke-width="3"></path>
  <circle cx={pivot[0]} cy={pivot[1]} r="8" fill="#657c80"></circle><circle
    cx={pivot[0]}
    cy={pivot[1]}
    r="3"
    fill="#e8d7b2"></circle>
  <circle cx={bob[0]} cy={bob[1]} r="15" fill="url(#esc-brass)"></circle>
  <circle cx="158" cy="130" r="10" fill={color}></circle>
  <path d="M300 47V183" stroke="#7a8175" stroke-width="1.5" stroke-dasharray="3 7"></path>
  <path
    d="M280 62C316 62 284 96 319 96C285 96 317 131 282 131C315 131 284 166 319 166"
    stroke="#638f82"
    stroke-width="2.2"
    stroke-linecap="round"></path>
  {
    [62, 96, 131, 166].map((y, i) => (
      <path
        d={`M337 ${y}h${i % 2 ? 24 : 13}v17h12`}
        stroke={color}
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ))
  }
</svg>
