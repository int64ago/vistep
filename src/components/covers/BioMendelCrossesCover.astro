---
import { mendelCross, mendelObservations } from '../../models/bio-mendel-crosses';
const cross = mendelCross('Dd', 'Dd');
const record = mendelObservations.self;
---

<svg viewBox="0 0 400 230" aria-hidden="true">
  <rect width="400" height="230" rx="24" fill="#efedde"></rect>
  <text x="92" y="38" text-anchor="middle" fill="#68765b" font-size="22">F₂</text>
  {
    [false, true].map((short, i) => (
      <g transform={`translate(${63 + i * 66} 158)`}>
        <path d={`M0 0V${short ? -43 : -94}`} stroke="#7b9760" stroke-width="3" fill="none" />
        <path
          d={`M0 ${short ? -18 : -48}q-26-21-26-8q10 14 26 8m0-10q26-21 26-8q-10 14-26 8`}
          fill="#a6b889"
        />
        <path
          d={`M0 ${short ? -43 : -94}q-15-12-15 0q7 13 15 3q8 10 15-3q-4-9-15 0`}
          fill="#ae94ad"
        />
        <path d="M-20 2H20" stroke="#bbb598" stroke-width="2" />
        <text y="33" text-anchor="middle" font-size="21" fill="#617052">
          {record.values[i]}
        </text>
      </g>
    ))
  }
  <path
    d="M173 112H212m-9-8 9 8-9 8"
    fill="none"
    stroke="#a5af94"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <text x="245" y="47" text-anchor="middle" fill="#607845" font-size="22">D</text>
  <text x="316" y="47" text-anchor="middle" fill="#607845" font-size="22">d</text>
  <text x="206" y="98" text-anchor="middle" fill="#745e78" font-size="22">D</text>
  <text x="206" y="159" text-anchor="middle" fill="#745e78" font-size="22">d</text>
  {
    cross.cells.map((c) => (
      <g transform={`translate(${222 + c.column * 71} ${65 + c.row * 61})`}>
        <rect
          width="61"
          height="53"
          rx="15"
          fill={c.phenotype === 'short' ? '#ded1df' : '#dce4ca'}
          stroke="#c3cbb4"
        />
        <text x="30.5" y="34" text-anchor="middle" font-size="21" fill="#637452">
          {c.genotype}
        </text>
      </g>
    ))
  }
</svg>
