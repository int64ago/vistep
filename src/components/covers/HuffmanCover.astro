---
import { huffman, huffmanLayout, HUFFMAN_TEXT } from '../../models/huffman';
const { color = '#b88d5f' } = Astro.props;
const run = huffman(HUFFMAN_TEXT),
  nodes = huffmanLayout(run.root);
---

<svg viewBox="0 0 400 230" width="400" height="230" fill="none" aria-hidden="true">
  {
    nodes
      .filter((n) => n.path)
      .map((n) => {
        const parent = nodes.find((a) => a.path === n.path.slice(0, -1))!;
        return (
          <path
            d={`M${30 + parent.x * 3.4} ${16 + parent.y * 1.7} L${30 + n.x * 3.4} ${16 + n.y * 1.7}`}
            stroke={color}
            stroke-width={run.codes.A.startsWith(n.path) ? 3 : 1.3}
            opacity={run.codes.A.startsWith(n.path) ? 1 : 0.45}
          />
        );
      })
  }
  {
    nodes.map((n) => (
      <g>
        <>
          <circle
            cx={30 + n.x * 3.4}
            cy={16 + n.y * 1.7}
            r={n.node.symbol ? 14 : 10}
            fill={n.node.symbol === 'A' ? '#e6c99b' : '#edf1e9'}
            stroke={color}
          />
          <text
            x={30 + n.x * 3.4}
            y={21 + n.y * 1.7}
            text-anchor="middle"
            fill="#435752"
            font-size={n.node.symbol ? 17 : 13}
            font-family="monospace"
          >
            {n.node.symbol ?? n.node.weight}
          </text>
        </>
      </g>
    ))
  }
  <text x="25" y="220" fill={color} font-size="15" font-family="monospace">42 bit → 28 bit</text>
</svg>
