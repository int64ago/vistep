---
import { fusionGeometry } from '../../models/bio-plant-cell-engineering';
const g = fusionGeometry(600, 0.66);
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#eef0dd"></rect><g transform="translate(200 114) scale(1.15)"
    ><path d={g.body.path} fill="#d9e1b8" stroke="#a3b68d" stroke-width="2"></path>{
      g.organelles.map((a) => (
        <ellipse
          cx={a.localX}
          cy={a.localY}
          rx="4.2"
          ry="2.5"
          fill={a.group ? '#b5aa7c' : '#94ae7f'}
        />
      ))
    }{
      [-1, 1].map((sign) => (
        <circle cx={sign * g.ns} r="9" fill={sign < 0 ? '#c5c3d4' : '#dcc1b3'} stroke="#b5a3b3" />
      ))
    }{
      g.markers.map((a) => (
        <path
          d={`M${a.localX - 2} ${a.localY - 2}q4 2 0 4`}
          stroke={a.group ? '#b28a74' : '#918da9'}
          stroke-width="2"
          fill="none"
        />
      ))
    }</g
  ><path d="M86 184q21-28 38-13q-13 23-38 13M315 51q-21 28-38 13q13-23 38-13" fill="#b8c79e"></path>
</svg>
