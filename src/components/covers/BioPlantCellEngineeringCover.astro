---
import {
  regenerationSequence,
  regenerationResponse,
} from '../../models/bio-plant-cell-engineering';
const grown = regenerationSequence(1);
const response = regenerationResponse(0.5, 3);
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#eef0dd"></rect>
  <ellipse cx="85" cy="113" rx="55" ry="41" fill="#e3e7ce" stroke="#acb99b" stroke-width="2"
  ></ellipse>
  <ellipse cx="85" cy="113" rx="34" ry="25" fill="#d8d4cf" stroke="#b6adb6"></ellipse>
  {
    response.information.map((id, i) => (
      <g>
        <rect x={63 + i * 15} y="99" width="9" height="28" rx="4.5" fill="#f3f1e7" />
        <rect
          x={63 + i * 15}
          y="99"
          width="9"
          height="28"
          rx="4.5"
          fill="#8fa577"
          opacity={0.25 + response.expression[i] * 0.65}
        />
      </g>
    ))
  }
  <path
    d="M149 112h46m-9-7 9 7-9 7"
    fill="none"
    stroke="#b1b998"
    stroke-width="2.5"
    stroke-linecap="round"></path>
  <path d="M224 163q60 18 120 0v23q-60 24-120 0Z" fill="#e2e4c8" stroke="#c2c7aa"></path>
  <ellipse cx="284" cy="163" rx="60" ry="12" fill="#ececda" stroke="#c2c7aa"></ellipse>
  <g transform="translate(284 153)">
    {
      [0, 1, 2, 3, 4].map((i) => (
        <path
          d={`M0 4Q${(i - 2) * 7 * grown.root} 29 ${(i - 2) * 11 * grown.root} 51m${-(i - 2) * 2} -13l${i % 2 ? 6 : -6} 8`}
          fill="none"
          stroke="#b49f77"
          stroke-width="1.7"
        />
      ))
    }
    {
      Array.from({ length: 13 }, (_, i) => (
        <ellipse
          cx={Math.cos(i * 2.4) * Math.sqrt(i / 13) * 19 * grown.callus}
          cy={Math.sin(i * 2.4) * Math.sqrt(i / 13) * 10 * grown.callus}
          rx="7"
          ry="6"
          fill={i % 2 ? '#c6c995' : '#d5d3a1'}
          stroke="#b1bc8e"
        />
      ))
    }
    <path
      d={`M0 0Q-5 ${-36 * grown.shoot} 3 ${-91 * grown.shoot}`}
      fill="none"
      stroke="#87a36f"
      stroke-width="4"
      stroke-linecap="round"></path>
    <path
      d="M0-27q-28-32-39-14q9 26 39 14M0-50q27-30 38-12q-10 21-38 12M2-73q-20-21-28-10q8 18 28 10"
      fill="#9eb781"
      stroke="#88a574"></path>
    <path d="M-1-29l-31-14M1-52l30-12M2-74l-22-10" stroke="#d4dfbd" fill="none"></path>
    <circle cy="5" r="5" fill="#ad8d53"></circle>
  </g>
</svg>
