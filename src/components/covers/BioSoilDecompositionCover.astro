---
import { litterState, leafHoles } from '../../models/bio-soil-decomposition';
const rows = [litterState(28, 0.12), litterState(28, 1)];
---

<svg viewBox="0 0 400 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#f1efe2"></rect>
  {
    rows.map((r, i) => (
      <g transform={`translate(${i === 0 ? 110 : 290} 105)`}>
        <>
          <path d="M-64-34h128v104q-64 21-128 0Z" fill="#e2ddc9" stroke="#c5bca3" />
          <path d="M-62 11h124v57q-62 20-124 0Z" fill="#a59673" />
          <ellipse cy="12" rx="62" ry="12" fill="#b6a682" />
        </>
        <>
          <defs>
            <mask id={`soil-cover-leaf-${i}`}>
              <path d="M0-56Q46-18 0 49Q-43 5 0-56Z" fill="white" />
              {leafHoles.map((h) => (
                <circle
                  cx={h.x * 1.25}
                  cy={h.y * 1.25}
                  r={h.r * Math.sqrt(1 - r.remaining) * 3.4}
                  fill="black"
                />
              ))}
            </mask>
          </defs>
          <path
            d="M0-56Q46-18 0 49Q-43 5 0-56Z"
            fill="#a68d58"
            mask={`url(#soil-cover-leaf-${i})`}
          />
          <path
            d="M0 49V-48m0 27 16-16M0 2l-15-14m15 33 14-13"
            stroke="#cab784"
            stroke-width="2"
            fill="none"
          />
        </>
        <path
          d="M-48 39h6m20 15h5m23-22h5m22 22h5"
          stroke="#c4b390"
          stroke-width="3"
          stroke-linecap="round"
        />
      </g>
    ))
  }
  <path d="M182 109h36m-7-7 7 7-7 7" stroke="#c2bea2" fill="none" stroke-width="2"></path>
</svg>
