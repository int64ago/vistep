---
import { ionicGeometry } from '../../models/chem-electron-transfer';
const g = ionicGeometry(400, 0.7, 2);
---

<svg viewBox={`0 0 400 ${g.height}`} fill="none" aria-hidden="true">
  {
    g.rows.map((r) => (
      <g>
        <path d={r.path} stroke="#bea375" stroke-dasharray="3 5" />
        <circle cx={r.left} cy={r.y} r="25" fill="#d6d5b4" />
        <circle cx={r.right} cy={r.y} r="27" fill="#b2c9ad" />
        <circle cx={r.left} cy={r.y} r={r.radius} stroke="#b9c3a7" stroke-dasharray="2 5" />
        <circle cx={r.right} cy={r.y} r={r.radius} stroke="#97b396" />
        {r.chlorine.map((e) => (
          <circle cx={e.x} cy={e.y} r="3.8" fill="#638875" />
        ))}
        <circle cx={r.moving.x} cy={r.moving.y} r="9" stroke="#b08442" stroke-width="1.5" />
        <circle cx={r.moving.x} cy={r.moving.y} r="4.8" fill="#bb8b43" />
        <text x={r.left} y={r.y + 6} text-anchor="middle" fill="#526951" font-size="20">
          {r.sodiumCharge ? 'Na⁺' : 'Na'}
        </text>
        <text x={r.right} y={r.y + 6} text-anchor="middle" fill="#526951" font-size="20">
          {r.chlorineCharge ? 'Cl⁻' : 'Cl'}
        </text>
      </g>
    ))
  }
  <text x="200" y={g.height - 12} text-anchor="middle" fill="#607c5b" font-size="22"
    >2Na + Cl₂ → 2NaCl</text
  >
</svg>
