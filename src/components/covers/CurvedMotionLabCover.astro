---
import { arcExit } from '../../models/curved-motion-lab';
const scale = 83,
  y = 139;
const panels = [
  { x: 85, angle: 0, color: '#b89272' },
  { x: 270, angle: -Math.PI / 6, color: '#8fa57e' },
].map((p) => {
  const state = arcExit(3, p.angle);
  const trace = Array.from({ length: 70 }, (_, i) => arcExit((i * 3) / 69, p.angle))
    .map((s, i) => `${i ? 'L' : 'M'}${p.x + s.x * scale} ${y - s.y * scale}`)
    .join(' ');
  const track = Array.from(
    { length: 50 },
    (_, i) => -Math.PI / 2 + ((p.angle + Math.PI / 2) * i) / 49,
  )
    .map(
      (a, i) =>
        `${i ? 'L' : 'M'}${p.x + 0.7 * Math.cos(a) * scale} ${y - 0.7 * Math.sin(a) * scale}`,
    )
    .join(' ');
  return { ...p, state, trace, track };
});
---

<svg viewBox="0 0 400 230" fill="none" aria-hidden="true">
  {
    panels.map((p) => (
      <g>
        <>
          <path d={p.track} stroke="#bdcbb2" stroke-width="12" />
          <path d={p.trace} stroke={p.color} stroke-width="2" />
          <circle cx={p.x + p.state.x * scale} cy={y - p.state.y * scale} r="5" fill={p.color} />
          <path
            d={`M${p.x + 0.7 * Math.cos(p.angle) * scale} ${y - 0.7 * Math.sin(p.angle) * scale}L${p.x} ${y}`}
            stroke="#c3cdb8"
            stroke-dasharray="4 5"
          />
          <path
            d={`M${p.x + p.state.x * scale} ${y - p.state.y * scale}l${p.state.vx * 20} ${-p.state.vy * 20}`}
            stroke={p.color}
            stroke-width="2"
          />
        </>
      </g>
    ))
  }
</svg>
