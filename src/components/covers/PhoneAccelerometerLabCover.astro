---
import { phoneSensor, phoneElectrodes } from '../../models/phone-accelerometer-lab';
const state = phoneSensor('drop', 0.2),
  e = phoneElectrodes(state.q),
  scale = 9e6;
const shift = -state.q * scale,
  half = ((e.massTop - e.massBottom) * scale) / 2;
const top = -e.topElectrode * scale,
  bottom = -e.bottomElectrode * scale;
const spring = (side: number) =>
  Array.from(
    { length: 13 },
    (_, i) =>
      `${i ? 'L' : 'M'} ${side * (82 - (i / 12) * 54)} ${(shift * i) / 12 + (i === 0 || i === 12 ? 0 : i % 2 ? -4 : 4)}`,
  ).join(' ');
---

<svg viewBox="0 0 400 230" aria-hidden="true">
  <path
    d="M 28 135 Q 45 124 68 124 H 122 Q 143 124 154 145 L 131 160 H 48 Z"
    fill="#dec6a6"
    stroke="#bda17d"></path>
  <rect x="29" y="105" width="125" height="19" rx="7" fill="#6f8b80" stroke="#365e52"></rect>
  <rect x="37" y="108" width="109" height="5" rx="2" fill="#d8e4dc"></rect>
  <rect x="105" y="116" width="11" height="6" rx="1" fill="#aa753b"></rect>
  <circle cx="110" cy="119" r="12" fill="none" stroke="#aa753b"></circle>
  <path
    d="M 118 108 L 171 61 M 121 127 L 171 172"
    stroke="#b4c5b6"
    stroke-dasharray="3 5"
    fill="none"></path>
  <g transform="translate(271 115)">
    <rect
      x="-101"
      y="-73"
      width="202"
      height="146"
      rx="18"
      fill="#edf1e5"
      stroke="#bccbc0"
      stroke-width="2"></rect>
    <path d="M -98 0 H 98" stroke="#c9d3c6" stroke-dasharray="3 5"></path>
    <path
      d={`M -101 ${top - 4} H 0 V ${top} M -101 ${bottom + 4} H 0 V ${bottom}`}
      stroke="#a7b5ab"
      fill="none"></path>
    <rect x="-26" y={top - 5} width="52" height="5" rx="2" fill="#4c7393"></rect>
    <rect x="-26" y={bottom} width="52" height="5" rx="2" fill="#4c7393"></rect>
    {
      [-1, 1].map((side) => (
        <g>
          <>
            <rect x={side < 0 ? -93 : 82} y="-9" width="11" height="18" rx="2" fill="#7c9184" />
            <path d={spring(side)} stroke="#8e9d8c" stroke-width="2.5" fill="none" />
          </>
        </g>
      ))
    }
    <rect
      x="-28"
      y={shift - half}
      width="56"
      height={half * 2}
      rx="4"
      fill="#c9c8a8"
      stroke="#94946d"></rect>
    <circle cx="0" cy={shift} r="4" fill="#aa753b"></circle>
    <path
      d={`M -45 ${shift} v -24 l -4 6 m 4 -6 l 4 6`}
      stroke="#386b60"
      stroke-width="2"
      fill="none"></path>
    <path
      d={`M 45 ${shift} v 24 l -4 -6 m 4 6 l 4 -6`}
      stroke="#aa753b"
      stroke-width="2"
      fill="none"></path>
  </g>
</svg>
