---
import { microscopic } from '../../models/chem-liquid-crystal';
const rods = microscopic(12, 0);
---

<svg viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
  ><rect width="640" height="400" fill="#e1e9d2"></rect><rect
    x="65"
    y="30"
    width="510"
    height="340"
    rx="40"
    fill="#d1dfc3"
    stroke="#a7bd9f"
    stroke-width="2"></rect>{
    rods.map((p) => (
      <g
        transform={`translate(${80 + p.x * 1.5} ${20 + p.y * 1.45}) rotate(${(p.angle * 180) / Math.PI})`}
      >
        {p.id === 0 && (
          <circle r="26" fill="none" stroke="#af945c" stroke-width="2" stroke-dasharray="3 6" />
        )}
        <rect
          x="-20"
          y="-7"
          width="40"
          height="14"
          rx="7"
          fill={p.id === 0 ? '#b6985e' : '#8aa783'}
          stroke="#729371"
          stroke-width="1"
        />
        <path d="M-13 -2 H11" fill="none" stroke="#dbe7c5" stroke-width="2" />
      </g>
    ))
  }</svg
>
