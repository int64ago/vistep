---
import { CACHE_MEMORY, CACHE_DEFAULT, runCache } from '../../models/memory-cache';
interface Props {
  color?: string;
}
const { color = '#547a80' } = Astro.props;
const state = runCache([0, 16, 0], { ...CACHE_DEFAULT, ways: 2 }).at(-1)!;
const byte = (a: number) => CACHE_MEMORY[a].toString(16).toUpperCase().padStart(2, '0');
const bases = [0, 4, 8, 12, 16, 20, 24, 28];
---

<svg viewBox="0 0 400 230" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="400" height="230" fill="#f0f2eb"></rect>
  <text x="22" y="25" fill="#5c7780" font-family="sans-serif" font-size="11" letter-spacing="2"
    >ADDRESS / DATA</text
  >
  {
    bases.map((base, index) => (
      <g transform={`translate(${22 + (index % 2) * 88} ${43 + Math.floor(index / 2) * 43})`}>
        <rect
          width="79"
          height="34"
          rx="7"
          fill={base === 0 || base === 16 ? '#dce7e3' : '#e9ece2'}
          stroke={color}
          stroke-opacity={base === 0 || base === 16 ? '.65' : '.14'}
        />
        <text x="7" y="12" font-family="sans-serif" font-size="9" fill="#6a8385">
          {String(base).padStart(2, '0')}–{String(base + 3).padStart(2, '0')}
        </text>
        {[0, 1, 2, 3].map((j) => (
          <text x={7 + j * 18} y="27" font-family="monospace" font-size="10" fill={color}>
            {byte(base + j)}
          </text>
        ))}
      </g>
    ))
  }
  <path
    d="M103 60C207 60 202 87 257 87M103 146C209 146 209 147 257 147"
    stroke={color}
    stroke-opacity=".65"
    stroke-width="1.3"
    stroke-linecap="round"></path>
  <rect x="242" y="42" width="139" height="159" rx="19" fill="#294658"></rect>
  <text x="257" y="63" fill="#d4e3e5" font-family="sans-serif" font-size="11">SET 0 · 2 WAYS</text>
  {
    state.sets[0].map((line, way) => (
      <g transform={`translate(254 ${73 + way * 61})`}>
        <rect width="115" height="51" rx="9" fill={way ? '#527a6d' : color} />
        <text x="9" y="16" fill="#f5f6e8" font-family="monospace" font-size="10">
          V{Number(line.valid)} T{line.tag} W{way}
        </text>
        <text x="9" y="35" fill="#f5f6e8" font-family="sans-serif" font-size="14">
          {String(line.block! * 4).padStart(2, '0')}–{String(line.block! * 4 + 3).padStart(2, '0')}
        </text>
        <text x="77" y="36" fill="#dce9d7" font-family="monospace" font-size="13">
          {byte(line.block! * 4)}
        </text>
      </g>
    ))
  }
</svg>
