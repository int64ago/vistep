---
import { monteSample } from '../../models/monte-carlo';
const { color = '#93a680' } = Astro.props,
  sample = monteSample(150, 7);
---

<svg viewBox="0 0 400 230" width="400" height="230" fill="none" aria-hidden="true">
  <rect x="105" y="20" width="190" height="190" rx="8" fill="#e7d9cc"></rect>
  <path d="M105 210H295A190 190 0 0 0 105 20Z" fill="#d6dfcf"></path>
  <path d="M295 210A190 190 0 0 0 105 20" stroke={color} stroke-width="2"></path>
  {
    sample.points.map((p) => (
      <circle cx={105 + p.x * 190} cy={210 - p.y * 190} r="2.2" fill={p.hit ? color : '#b9846e'} />
    ))
  }
</svg>
