---
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/interaction.css';
import '../styles/showcase.css';
import '../styles/language.css';
import '../styles/longform.css';
import '../i18n/english';
import { translate, localPath, type Locale } from '../i18n';
import { pageSchema, structuredJSON } from '../data/seo';
import { topics, type Topic } from '../data/topics';
import { bootLanguage, resolveLanguage } from '../i18n/resolve-language';
import { BROWSER_BASELINE, bootBrowserSupport, browserSupportGaps } from '../lib/browser-support';
interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  topic?: Topic;
  noindex?: boolean;
}
const { locale = 'zh' } = Astro.props;
const tr = (s: string) => translate(s, locale);
const title = Astro.props.title ?? tr('vistep.ai — 让每一步原理变得可见');
const description =
  Astro.props.description ?? tr('从自行车到大模型，用可视化看懂生活和工作背后的每一步。');
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`/social/${Astro.props.topic?.slug ?? 'home'}.png`, Astro.site);
const schema = pageSchema(Astro.url.pathname, locale, Astro.props.topic);
const home = localPath('/', locale);
const alternate = localPath(Astro.url.pathname, locale === 'en' ? 'zh' : 'en');
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    {
      Astro.url.pathname === '/' && (
        <script
          is:inline
          set:html={`(${bootLanguage.toString()})(${resolveLanguage.toString()});`}
        />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <meta
      name="robots"
      content={Astro.props.noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta property="og:type" content={Astro.props.topic ? 'article' : 'website'} />
    <meta property="og:site_name" content="vistep.ai" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      !Astro.props.noindex && (
        <script type="application/ld+json" is:inline set:html={structuredJSON(schema)} />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="zh-CN"
      href={new URL(localPath(Astro.url.pathname, 'zh'), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(localPath(Astro.url.pathname, 'en'), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(
        ['/', '/zh/', '/en/'].includes(Astro.url.pathname)
          ? '/'
          : localPath(Astro.url.pathname, 'en'),
        Astro.site,
      )}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div id="browser-support" class="browser-support" role="alert" hidden>
      <strong>{tr('这个浏览器不支持 vistep.ai 的互动实验。')}</strong>
      <p>{translate('请使用 {0} 或更新的版本。', locale, BROWSER_BASELINE)}</p>
      <p class="browser-support-gaps">{tr('缺少：')}<span data-gaps></span></p>
    </div>
    <script
      is:inline
      set:html={`(${bootBrowserSupport.toString()})(${browserSupportGaps.toString()},window);`}
    />
    <a href="#main" class="skip-link">{tr('跳到主要内容')}</a>
    <header class="site-header">
      <a class="wordmark" href={home} aria-label={tr('vistep.ai 首页')}
        ><span class="brand-symbol" aria-hidden="true"
          ><svg viewBox="0 0 28 28" fill="none"
            ><path
              d="m3 6 9 17L25 3M9 6l6 11M15 6l3 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          ></span
        ><span class="wordmark-name">vistep<span class="wordmark-ai">.ai</span></span></a
      >
      <nav aria-label={tr('主导航')}>
        <a href={`${home}#collection`}
          >{tr('全部探索')} <span class="nav-count">{topics.length}</span></a
        >
        <a href={`${home}#name`} class="name-link"
          >{tr('关于 vistep')} <span aria-hidden="true">↗</span></a
        >
        <a
          class="language-switch"
          href={alternate}
          lang={locale === 'en' ? 'zh-CN' : 'en'}
          hreflang={locale === 'en' ? 'zh-CN' : 'en'}
          data-language={locale === 'en' ? 'zh' : 'en'}
          aria-label={locale === 'en' ? '切换到中文' : 'Switch to English'}
          >{locale === 'en' ? '中文' : 'EN'}</a
        >
        <a
          class="github-link"
          href="https://github.com/int64ago/vistep"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={tr('在 GitHub 上查看源码')}
          title="GitHub"
          ><svg viewBox="0 0 16 16" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          ></a
        >
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <a class="wordmark" href={home}>vistep<span class="wordmark-ai">.ai</span></a><p>
        Visualize Every Step with AI<span>{tr('让每一步原理变得可见')}</span>
      </p><span class="footer-note"
        >{tr('好奇心，是最好的起点。')}<small>© {new Date().getFullYear()} vistep</small></span
      >
    </footer>
    <script>
      import { manualLanguageClick } from '../lib/film-language';

      document
        .querySelector<HTMLAnchorElement>('.language-switch')
        ?.addEventListener('click', manualLanguageClick);
    </script>
  </body>
</html>
